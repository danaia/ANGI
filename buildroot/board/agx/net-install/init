#!/bin/busybox sh
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
exec </dev/console >/dev/console 2>&1
mkdir -p /run/installer /dev/pts
mount -t devpts devpts /dev/pts
chmod 700 /root/.ssh
chmod 600 /root/.ssh/authorized_keys

echo 'ANGI Ethernet installer'
for interface in /sys/class/net/*; do
    name=${interface##*/}
    [ "$name" = lo ] && continue
    ip link set "$name" up
done
attempt=0
while [ "$attempt" -lt 30 ]; do
    for interface in /sys/class/net/*; do
        name=${interface##*/}
        [ "$name" = lo ] && continue
        [ "$(cat "$interface/carrier" 2>/dev/null || true)" = 1 ] || continue
        ip address add 10.78.0.2/24 dev "$name"
        dropbearkey -t ed25519 -f /run/installer/host.key
        echo 'Read the SHA256 fingerprint above to the workstation agent.'
        touch /run/installer/active
        dropbear -F -E -s -j -k -p 10.78.0.2:22 -r /run/installer/host.key
        exit 1
    done
    sleep 1
    attempt=$((attempt + 1))
done
echo 'No wired link was detected. Check the cable and restart the installer.'
exec sleep infinity
