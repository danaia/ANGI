#!/bin/sh
# Mount the explicitly configured AGX data filesystem, if present.
prepare_apps() {
    if test -x /usr/bin/opencode; then
        opencode_users=/var/lib/agx-data/agx-opencode-users
        test ! -L "$opencode_users" || { echo 'Refusing symlinked OpenCode storage parent' >&2; return 1; }
        mkdir -p "$opencode_users" && chown 0:0 "$opencode_users" && chmod 1777 "$opencode_users" || return 1
    fi
}
case "$1" in
    start)
        if test -x /usr/libexec/agx-zram; then
            /usr/libexec/agx-zram start || echo 'ANGI compressed swap unavailable' >&2
        fi
        test -r /etc/agx/data-volume.uuid || exit 0
        uuid=$(cat /etc/agx/data-volume.uuid)
        case "$uuid" in ''|*[!0-9a-fA-F-]*) echo 'Invalid AGX data UUID' >&2; exit 1 ;; esac
        mkdir -p /var/lib/agx-data
        if mountpoint -q /var/lib/agx-data; then prepare_apps; exit $?; fi
        for node in /sys/class/block/*/partition; do
            test -f "$node" || continue
            part=${node%/partition}
            name=${part##*/}
            case "$name" in
                nvme*n*p*) ;;
                sd*)
                    disk=$(dirname "$(readlink -f "$part")")
                    case "$disk" in */ata[0-9]*/*) ;; *) continue ;; esac
                    test "$(cat "$disk/removable" 2>/dev/null)" = 0 || continue
                    ;;
                *) continue ;;
            esac
            device=/dev/$name
            test -b "$device" || continue
            if blkid "$device" | grep -Fq "UUID=\"$uuid\""; then
                mount -t ext4 -o noatime,nosuid,nodev "$device" /var/lib/agx-data || exit $?
                prepare_apps
                exit $?
            fi
        done
        echo 'AGX data volume not found' >&2
        exit 1
        ;;
    prepare) mountpoint -q /var/lib/agx-data && prepare_apps ;;
    stop)
        if test -x /usr/libexec/agx-zram; then
            /usr/libexec/agx-zram stop || true
        fi
        mountpoint -q /var/lib/agx-data && umount /var/lib/agx-data || true
        ;;
    *) exit 0 ;;
esac
