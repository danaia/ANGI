 /* Use a float as we only have the depth aspect in the staging buffers. */
 struct Depth32fStencil8 : ComponentValue<float> {};
 
+/* Buffer copies of the D24 depth aspect use the low 24 bits of each uint32_t. */
+struct Depth24Stencil8 : ComponentValue<uint32_t> {};
+constexpr uint32_t depth_24_max = 0xFFFFFF;
+
+static void convert(Depth24Stencil8 &dst, const F32 &src)
+{
+  dst.value = uint32_t(clamp_f(src.value, 0.0f, 1.0f) * float(depth_24_max));
+}
+
+static void convert(F32 &dst, const Depth24Stencil8 &src)
+{
+  dst.value = float(src.value & depth_24_max) / float(depth_24_max);
+}
+
+static void convert(Depth24Stencil8 &dst, const UI32 &src)
+{
+  dst.value = src.value >> 8;
+}
+
+static void convert(UI32 &dst, const Depth24Stencil8 &src)
+{
+  dst.value = (src.value & depth_24_max) << 8;
+}
