 VkFormat to_vk_format(const TextureFormat format)
 {
+  if (format == TextureFormat::SFLOAT_32_DEPTH_UINT_8) {
+    const VkPhysicalDevice device = VKBackend::get().device.physical_device_get();
+    if (device != VK_NULL_HANDLE) {
+      /* Vulkan devices need to support at least one of these packed depth/stencil formats. */
+      constexpr VkFormatFeatureFlags required = VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT |
+                                                VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+      VkFormatProperties properties;
+      vkGetPhysicalDeviceFormatProperties(device, VK_FORMAT_D32_SFLOAT_S8_UINT, &properties);
+      if ((properties.optimalTilingFeatures & required) != required) {
+        vkGetPhysicalDeviceFormatProperties(device, VK_FORMAT_D24_UNORM_S8_UINT, &properties);
+        if ((properties.optimalTilingFeatures & required) == required) {
+          return VK_FORMAT_D24_UNORM_S8_UINT;
+        }
+      }
+    }
+  }
