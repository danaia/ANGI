#!/bin/sh
# Compressed swap gives the desktop headroom without writing swap to the SD card.
case "$1" in
    start)
        grep -q '^/dev/zram0 ' /proc/swaps && exit 0
        printf '%s\n' 536870912 > /sys/block/zram0/disksize &&
            mkswap /dev/zram0 && swapon /dev/zram0
        ;;
    stop)
        if grep -q '^/dev/zram0 ' /proc/swaps; then
            swapoff /dev/zram0
        fi
        ;;
esac
