#!/bin/sh
# A direct cable has no DHCP server. Give one connected wired adapter a maintenance address.
case "${interface:-}" in ''|*[!a-zA-Z0-9_.-]*) exit 0 ;; esac
device=/sys/class/net/$interface
[ -e "$device/device" ] && [ ! -e "$device/phy80211" ] && [ ! -d "$device/wireless" ] || exit 0
state=/run/network/agx-direct-ethernet
address=10.78.0.2/24

case "${1:-}" in
    leasefail)
        [ "$(cat "$device/carrier" 2>/dev/null)" = 1 ] || exit 0
        [ -z "$(ip -4 -o addr show dev "$interface" scope global)" ] || exit 0
        mkdir "$state" 2>/dev/null || exit 0
        if arping -D -q -I "$interface" -c 1 -w 1 "${address%/*}" &&
            ip addr add "$address" dev "$interface"; then
            printf '%s\n' "$interface" > "$state/interface"
        else
            rmdir "$state"
        fi
        ;;
    bound|renew|deconfig|nak)
        [ "$(cat "$state/interface" 2>/dev/null)" = "$interface" ] || exit 0
        # When the lease already uses the maintenance address, keep the leased address.
        [ "${ip:-}" = "${address%/*}" ] || ip addr del "$address" dev "$interface" 2>/dev/null
        rm -f "$state/interface"
        rmdir "$state"
        ;;
esac
exit 0
