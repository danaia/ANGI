Subject: [PATCH] desktop-shell: Track native windows on ANGI workspaces

Move toplevels between visible and hidden layers while preserving their
views and window geometry. Keep the ANGI desktop surface visible.

--- a/desktop-shell/shell.h
+++ b/desktop-shell/shell.h
@@ -128,6 +128,7 @@
 		struct weston_coord_global pos;
 	} xwayland;
 
+	unsigned angi_workspace;
 	int focus_count;
 
 	bool destroying;
@@ -292,6 +293,11 @@
 	struct weston_view *lock_view;
 
 	struct workspace workspace;
+	struct weston_layer angi_hidden;
+	unsigned angi_workspace;
+	struct wl_event_source *angi_workspace_source;
+	char *angi_workspace_path;
+	int angi_workspace_fd;
 
 	struct {
 		struct wl_resource *binding;
@@ -329,6 +335,18 @@
 	struct timespec startup_time;
 };
 
+bool
+angi_workspace_visible(struct shell_surface *surface);
+
+void
+angi_workspaces_init(struct desktop_shell *shell);
+
+void
+angi_workspaces_fini(struct desktop_shell *shell);
+
+void
+shell_surface_update_layer(struct shell_surface *surface);
+
 struct weston_output *
 get_default_output(struct weston_compositor *compositor);
 
--- a/desktop-shell/meson.build
+++ b/desktop-shell/meson.build
@@ -3,6 +3,7 @@
 
 	srcs_shell_desktop = [
 		'shell.c',
+		'angi-workspaces.c',
 		'input-panel.c',
 		weston_desktop_shell_server_protocol_h,
 		weston_desktop_shell_protocol_c,
--- a/desktop-shell/shell.c
+++ b/desktop-shell/shell.c
@@ -1480,6 +1480,9 @@
 {
 	struct workspace *ws;
 
+	if (!angi_workspace_visible(shsurf))
+		return &shsurf->shell->angi_hidden.view_list;
+
 	if (weston_desktop_surface_get_fullscreen(shsurf->desktop_surface) &&
 	    !shsurf->state.lowered) {
 		return &shsurf->shell->fullscreen_layer.view_list;
@@ -1503,7 +1506,7 @@
  *
  * If any child surfaces exist and are mapped, ensure they’re in the same layer
  * as this surface. */
-static void
+void
 shell_surface_update_layer(struct shell_surface *shsurf)
 {
 	struct weston_layer_entry *new_layer_link;
@@ -1512,6 +1515,11 @@
 	assert(new_layer_link);
 
 	weston_view_move_to_layer(shsurf->view, new_layer_link);
+	if (shsurf->fullscreen.black_view &&
+	    (new_layer_link->layer == &shsurf->shell->angi_hidden ||
+	     new_layer_link->layer == &shsurf->shell->fullscreen_layer))
+		weston_view_move_to_layer(shsurf->fullscreen.black_view->view,
+		                          &shsurf->view->layer_link);
 	shell_surface_update_child_surface_layers(shsurf);
 }
 
@@ -1951,7 +1959,8 @@
 
 	weston_surface_set_label_func(surface, weston_shell_utils_surface_get_label);
 
-	shsurf->shell = (struct desktop_shell *) shell;
+	shsurf->shell = shell;
+	shsurf->angi_workspace = shsurf->shell->angi_workspace;
 	shsurf->unresponsive = 0;
 	shsurf->saved_position_valid = false;
 	shsurf->saved_rotation_valid = false;
@@ -2014,7 +2023,7 @@
 	weston_desktop_surface_set_user_data(shsurf->desktop_surface, NULL);
 	shsurf->desktop_surface = NULL;
 
-	if (weston_view_is_mapped(shsurf->view) &&
+	if (weston_view_is_mapped(shsurf->view) && shsurf->view->output &&
 	    shsurf->shell->win_close_animation_type == ANIMATION_FADE) {
 
 		if (shsurf->shell->compositor->state == WESTON_COMPOSITOR_ACTIVE &&
@@ -2135,7 +2144,8 @@
 				 WESTON_ACTIVATE_FLAG_FULLSCREEN : 0));
 	}
 
-	if (!shsurf->state.fullscreen && !shsurf->state.maximized) {
+	if (angi_workspace_visible(shsurf) &&
+	    !shsurf->state.fullscreen && !shsurf->state.maximized) {
 		switch (shell->win_animation_type) {
 		case ANIMATION_FADE:
 			weston_fade_run(shsurf->view, 0.0, 1.0, NULL, NULL);
@@ -2408,8 +2418,11 @@
 
 	if (parent) {
 		shsurf_parent = weston_desktop_surface_get_user_data(parent);
+		shsurf->angi_workspace = shsurf_parent->angi_workspace;
 		wl_list_insert(shsurf_parent->children_list.prev,
 			       &shsurf->children_link);
+		if (weston_view_is_mapped(shsurf->view))
+			shell_surface_update_layer(shsurf);
 	} else {
 		wl_list_init(&shsurf->children_link);
 	}
@@ -3483,6 +3496,9 @@
 	main_surface = weston_surface_get_main_surface(es);
 	shsurf = get_shell_surface(main_surface);
 	assert(shsurf);
+
+	if (!angi_workspace_visible(shsurf))
+		return;
 
 	shsurf_child = get_last_child(shsurf);
 	if (shsurf_child) {
@@ -4677,6 +4693,8 @@
 	weston_desktop_destroy(shell->desktop);
 
 	workspace_destroy(&shell->workspace);
+	angi_workspaces_fini(shell);
+	desktop_shell_destroy_layer(&shell->angi_hidden);
 
 	desktop_shell_destroy_layer(&shell->panel_layer);
 	desktop_shell_destroy_layer(&shell->background_layer);
@@ -4854,6 +4872,7 @@
 	wl_list_init(&shell->workspace.focus_list);
 	wl_list_init(&shell->workspace.seat_destroyed_listener.link);
 
+	weston_layer_init(&shell->angi_hidden, ec);
 	weston_layer_init(&shell->minimized_layer, ec);
 	weston_layer_init(&shell->workspace.layer, ec);
 
@@ -4866,6 +4885,9 @@
 		return -1;
 
 	workspace_create(shell);
+	weston_layer_set_position(&shell->angi_hidden, WESTON_LAYER_POSITION_HIDDEN);
+	weston_layer_set_mask(&shell->angi_hidden, 0, 0, 0, 0);
+	angi_workspaces_init(shell);
 
 	shell->desktop = weston_desktop_create(ec, &shell_desktop_api, shell);
 	if (!shell->desktop)
