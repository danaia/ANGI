Allow Weston VNC through an authenticated SSH tunnel on ANGI

ANGI uses OpenSSH for authentication and encryption. Require an explicit IPv4 loopback address and the TLS opt-out before allowing an unauthenticated connection.

--- a/libweston/meson.build
+++ b/libweston/meson.build
@@ -109,11 +109,10 @@
 	if not dep_pam.found()
 		dep_pam = cc.find_library('pam', required: false)
 	endif
-	if not dep_pam.found()
-		error('VNC backend requires libpam which was not found. Or, you can use \'-Dbackend-vnc=false\'.')
+	if dep_pam.found()
+		config_h.set('HAVE_PAM', '1')
+		deps_libweston += dep_pam
 	endif
-	config_h.set('HAVE_PAM', '1')
-	deps_libweston += dep_pam
 endif
 
 if get_option('perfetto')
