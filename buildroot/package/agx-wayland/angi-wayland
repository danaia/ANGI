#!/bin/sh
# Run on an available local VT, through a VNC tunnel, or in a headless test.
set -eu

if [ "$(id -u)" = 0 ]; then
	printf 'Start the ANGI Wayland session from a signed-in user account.\n' >&2
	exit 1
fi

umask 077
remote=false
case "${1:-}" in
	"") set -- --backend=drm --renderer=gl ;;
	--login) set -- --backend=drm --renderer=gl ;;
	--vnc)
		remote=true
		# Give single-instance apps a profile scoped to the remote session.
		XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/angi-vnc"
		export XDG_CONFIG_HOME
		set -- --backend=vnc --renderer=gl --width=1280 --height=720 \
			--address=127.0.0.1 --port=5900 --disable-transport-layer-security
		;;
	--headless)
		export AGX_WAYLAND_RENDERER=software
		set -- --backend=headless --renderer=pixman
		;;
	--next-login)
		printf 'Sign out, then choose Full Desktop on the ANGI sign-in screen.\n'
		exit 0
		;;
	--regular-next-login)
		printf 'Sign out, then choose Native on the ANGI sign-in screen.\n'
		exit 0
		;;
	*) printf 'Usage: angi-wayland [--next-login | --regular-next-login | --vnc | --headless]\n' >&2; exit 2 ;;
esac

XDG_RUNTIME_DIR=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/angi-wayland.XXXXXXXX")
export XDG_RUNTIME_DIR
export XDG_SESSION_TYPE=wayland
case "${XDG_CONFIG_HOME:-}" in
	/*) AGX_WAYLAND_MOUSE_CONFIG="$XDG_CONFIG_HOME/agx/mouse.conf" ;;
	*) AGX_WAYLAND_MOUSE_CONFIG="$HOME/.config/agx/mouse.conf" ;;
esac
export AGX_WAYLAND_MOUSE_CONFIG
unset DISPLAY WAYLAND_DISPLAY WAYLAND_SOCKET
# Use the UTF-8 locale shipped on ANGI images.
export LANG="${LANG:-C.UTF-8}"

weston_pid=
cleanup() {
	if [ -n "$weston_pid" ]; then
		kill "$weston_pid" 2>/dev/null || :
		wait "$weston_pid" 2>/dev/null || :
	fi
	rm -rf -- "$XDG_RUNTIME_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

config=/usr/share/agx/wayland/weston.ini
if [ "$remote" = false ] && [ -r "$HOME/.config/agx/weston.ini" ]; then
	config="$HOME/.config/agx/weston.ini"
fi
if [ "${AGX_WAYLAND_DEBUG:-0}" = 1 ]; then
	set -- "$@" --debug
fi
weston "$@" --config="$config" &
weston_pid=$!
status=0
wait "$weston_pid" || status=$?
weston_pid=
exit "$status"
