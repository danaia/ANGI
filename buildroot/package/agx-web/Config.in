config BR2_PACKAGE_AGX_WEB
	bool "ANGI Web application"
	depends on BR2_aarch64 || BR2_x86_64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_HAS_LIBEGL
	depends on BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_AGX_WEBKIT
	help
	  Lightweight WPEPlatform embedding host for the ANGI desktop.
	  Launched on demand by the GUI's Web app.

config BR2_PACKAGE_AGX_WEB_SD_STORAGE
	bool "Allow browser storage on the system card"
	depends on BR2_PACKAGE_AGX_WEB
	help
	  Use private per-account storage when no separate data volume is mounted.
