import { Theme } from "data.slint";
import { AngiMark } from "agent-controls.slint";

// The desktop owns these messages and sends turns to the agent runtime.
export struct ChatMessage {
    mine: bool,
    text: string,
    failed: bool,
}

export global AgentChat {
    in-out property <[ChatMessage]> messages;
    in-out property <bool> busy;
    in-out property <string> draft;
    in-out property <string> session-id;
    callback send(string);
    callback new-chat();
}

component MessageText inherits TextInput {
    single-line: false;
    read-only: true;
    wrap: word-wrap;
    font-family: "Noto Sans";
    font-size: Theme.text-label;
    color: Theme.ink;
    selection-background-color: Theme.selection;
    selection-foreground-color: Theme.ink;
    vertical-stretch: 0;
}

component ChatTurn inherits VerticalLayout {
    in property <ChatMessage> message;
    spacing: 8px;

    if root.message.mine: HorizontalLayout {
        alignment: end;
        Rectangle {
            max-width: root.width * 0.8;
            border-radius: Theme.radius-md;
            background: Theme.surface-muted;
            border-width: 0px;
            VerticalLayout {
                padding-left: 16px; padding-right: 16px;
                padding-top: 11px; padding-bottom: 11px;
                MessageText { text: root.message.text; }
            }
        }
    }
    if !root.message.mine: VerticalLayout {
        spacing: 9px;
        HorizontalLayout {
            spacing: 9px; alignment: start;
            AngiMark { width: 25px; height: 25px; }
            Text {
                text: root.message.failed ? "Couldn’t complete the reply" : "Angi";
                font-family: "Noto Sans"; font-size: Theme.text-body-sm; font-weight: 600;
                color: root.message.failed ? Theme.danger : Theme.ink;
                vertical-alignment: center;
            }
        }
        MessageText {
            text: root.message.text;
            color: root.message.failed ? Theme.danger : Theme.ink;
        }
    }
}

component Thinking inherits HorizontalLayout {
    spacing: 9px; alignment: start;
    property <int> tick: mod(floor(animation-tick() / 1s * 3), 3);
    AngiMark { width: 25px; height: 25px; }
    Text {
        text: "Working…"; font-family: "Noto Sans"; font-size: Theme.text-body-sm;
        color: Theme.ink; vertical-alignment: center;
    }
    for dot in 3: Rectangle {
        width: 4px; height: 4px; border-radius: 2px;
        background: Theme.accent; opacity: root.tick == dot ? 1.0 : 0.3;
    }
}

export component ChatMessages inherits Rectangle {
    clip: true;
    flick := Flickable {
        width: root.width; height: root.height;
        content-width: self.width;
        content-height: turns.preferred-height;
        changed content-height => { self.content-y = min(0px, self.height - self.content-height); }
        turns := VerticalLayout {
            width: parent.width;
            padding-top: 24px; padding-bottom: 25px; padding-right: 8px;
            spacing: 26px; alignment: start;
            for message in AgentChat.messages: ChatTurn { message: message; }
            if AgentChat.busy: Thinking { }
        }
    }
}
