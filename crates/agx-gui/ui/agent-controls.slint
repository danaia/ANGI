import { Theme } from "data.slint";
import { FocusRing, Icon } from "pebble/pebble.slint";
import "fonts/NotoSans-Regular.ttf";
import "fonts/NotoSans-Bold.ttf";

// Conversation and file content: Noto Sans covers far more scripts than Poppins. Use it only for
// text the person or the model wrote; controls and labels use the default Poppins.
export component AgentText inherits Text {
    font-family: "Noto Sans";
    color: Theme.ink;
}

export component AngiMark inherits Rectangle {
    border-radius: self.width / 2;
    background: Theme.surface-muted;
    Image {
        width: parent.width * 0.56; height: parent.height * 0.56;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        source: @image-url("../../../brand/brand-bug.svg");
        image-fit: contain;
        colorize: Theme.ink;
    }
}

export component AgentButton inherits Rectangle {
    in property <string> label;
    in property <string> action-label;
    in property <string> detail;
    in property <string> symbol;
    // A Pebble Line icon for an icon-only button; without one the button draws `symbol`.
    in property <image> icon;
    in property <string> badge;
    in property <color> badge-color: Theme.accent;
    in property <bool> brand-mark;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> icon-only;
    out property <bool> hovered: mouse.has-hover;
    in property <bool> highlighted;
    in property <length> minimum: 36px;
    callback activated();
    callback secondary-click(length, length);
    forward-focus: focus;
    min-height: root.minimum;
    // Pebble Line: pill for a single line, a radius-md card when it carries a detail line.
    border-radius: root.detail != "" ? Theme.radius-md : self.height / 2;
    border-width: root.primary && root.enabled ? 0px : Theme.stroke-hair;
    border-color: mouse.has-hover ? Theme.line-strong : Theme.line;
    background: !root.enabled ? Theme.surface-muted : root.primary ? (mouse.has-hover ? Theme.accent-hover : Theme.accent)
        : root.highlighted ? Theme.surface-muted : mouse.has-hover ? Theme.surface-hover : Theme.surface;
    animate background { duration: 150ms; }
    accessible-role: button;
    accessible-label: root.action-label == "" ? root.label : root.action-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }
    if root.icon-only && root.brand-mark: AngiMark {
        width: parent.width - 6px; height: self.width;
    }
    if root.icon-only && !root.brand-mark && root.icon.width > 0: Icon {
        source: root.icon; color: mouse.has-hover ? Theme.ink : Theme.ink-muted;
        width: 20px; height: 20px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
    if root.icon-only && !root.brand-mark && root.icon.width == 0: Text {
        text: root.symbol; font-family: "Noto Sans"; font-size: Theme.text-title; color: mouse.has-hover ? Theme.ink : Theme.ink-muted;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if !root.icon-only: HorizontalLayout {
        padding-left: Theme.space-4; padding-right: Theme.space-4; spacing: Theme.space-2;
        if root.symbol != "": Text {
            text: root.symbol; font-size: Theme.text-label; font-family: "Noto Sans";
            horizontal-stretch: 0; min-width: 13px;
            color: root.primary && root.enabled ? Theme.on-accent : Theme.ink-muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            min-width: 0px; horizontal-stretch: 1;
            alignment: center; spacing: 3px;
            Text {
                text: root.label; overflow: elide;
                color: !root.enabled ? Theme.ink-subtle : root.primary ? Theme.on-accent : Theme.ink;
                font-size: Theme.text-body-sm; font-weight: 500; horizontal-alignment: left;
            }
            if root.detail != "": Text {
                text: root.detail; overflow: elide;
                color: root.primary ? Theme.on-accent : Theme.ink-muted; font-size: Theme.text-small;
            }
        }
        if root.badge != "": Rectangle {
            width: 76px;
            // Badge: outlined pill with a status dot in `badge-color` and a word.
            Rectangle {
                width: parent.width; height: 22px; y: (parent.height - self.height) / 2;
                border-radius: 11px; border-width: Theme.stroke-hair;
                border-color: Theme.line-strong;
                Rectangle { x: 9px; y: 8px; width: 6px; height: 6px; border-radius: 3px; background: root.badge-color; }
                Text {
                    x: 19px; width: parent.width - 25px;
                    text: root.badge; color: Theme.ink; font-size: Theme.text-caption; font-weight: 500;
                    horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                }
            }
        }
    }
    FocusRing { width: parent.width + 8px; height: parent.height + 8px; shown: focus.has-focus; radius: root.border-radius; }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.activated(); return accept; }
            reject
        }
        mouse := TouchArea {
            enabled: root.enabled; mouse-cursor: pointer;
            clicked => { focus.focus(); root.activated(); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    root.secondary-click(self.mouse-x, self.mouse-y);
                }
            }
        }
    }
}

