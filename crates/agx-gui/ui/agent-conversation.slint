import { Theme } from "data.slint";
import { AgentButton, AgentText } from "agent-controls.slint";
import { AgentChat, ChatMessages } from "agent-chat.slint";
import { AgentHistory } from "agent-history.slint";
import { AgentProviders } from "agent-providers.slint";
import { AgentScope, ModeSwitch, ScopeTip } from "agent-scope.slint";
import { HoverDwell, HoverTip } from "hover-tip.slint";
import { AgentKnowledge } from "agent-knowledge.slint";
import { Icons } from "pebble/pebble.slint";

struct AgentSuggestion { label: string, detail: string, prompt: string }
component AgentWelcome inherits Flickable {
    callback suggest(string);
    property <bool> wide: self.width >= 570px;
    property <[AgentSuggestion]> suggestions: AgentScope.mode == "os" ? [
        { label: "Improve the desktop", detail: "Plan a focused change", prompt: "Help me plan a focused improvement to the ANGI desktop. Ask me what should change." },
        { label: "Check a service", detail: "Review a system service", prompt: "Help me check an ANGI system service. Ask me which service to inspect." },
        { label: "Update documentation", detail: "Start with the system docs", prompt: "Help me update the ANGI documentation. Ask me what needs to change." },
    ] : AgentScope.mode == "project" ? [
        { label: "Review the project", detail: "Understand the selected folder", prompt: "Review this project and summarize how it is organized." },
        { label: "Build a starter page", detail: "Start with an index.html", prompt: "Make a simple, accessible starter index.html for this project." },
        { label: "Write a README", detail: "Document setup and usage", prompt: "Write a README that explains this project, how to set it up, and how to use it." },
    ] : [
        { label: "Explore files", detail: "See what’s in this folder", prompt: "List the files and folders here and summarize what you find." },
        { label: "Make a web page", detail: "Create a starter index.html", prompt: "Create a folder called starter-site and save a simple, accessible index.html inside it." },
        { label: "Draft a note", detail: "Get a first draft going", prompt: "Help me draft a short note. Ask me who it’s for and what I want to say." },
    ];
    content-width: root.width;
    content-height: max(root.height, welcome.preferred-height + 24px);
    welcome := VerticalLayout {
        width: root.width;
        height: self.preferred-height;
        y: max(12px, (root.content-height - self.height) / 2 - 18px);
        spacing: root.wide ? 21px : 12px;
        Rectangle {
            height: root.wide ? 128px : 72px;
            Image {
                width: self.height; height: parent.height;
                x: (parent.width - self.width) / 2;
                source: @image-url("../../../brand/brand-bug.svg");
                image-fit: contain;
                colorize: Theme.ink;
            }
        }
        Text {
            text: AgentScope.mode == "os" ? "Extend ANGI."
                : AgentScope.mode == "project" ? "Build custom projects" : "Talk to me about your projects";
            font-family: "Noto Sans"; font-weight: 400;
            font-size: root.wide ? 32px : root.width >= 350px ? 22px : 18px;
            color: Theme.ink; horizontal-alignment: center; wrap: word-wrap;
        }
        Rectangle { height: root.wide ? 11px : 3px; }
        if root.wide: HorizontalLayout {
            spacing: 12px;
            for item in root.suggestions: AgentButton {
                width: (root.width - 24px) / 3; minimum: 72px;
                label: item.label; detail: item.detail;
                activated => { root.suggest(item.prompt); }
            }
        }
        if !root.wide: VerticalLayout {
            spacing: 7px;
            for item in root.suggestions: AgentButton {
                minimum: 35px; label: item.label;
                activated => { root.suggest(item.prompt); }
            }
        }
    }
}

component AgentComposer inherits Rectangle {
    in-out property <string> draft;
    in property <bool> active;
    in property <int> focus-request;
    property <bool> chatting: AgentScope.mode == "chat";
    // Reserve the Build button, three gaps and the composer padding at narrow widths.
    property <length> scope-controls-width: max(0px, root.width - 83px);
    property <length> control-width: min(130px, root.scope-controls-width / 2);
    property <bool> can-send: root.draft != "" && AgentScope.ready && !AgentHistory.loading && (!root.chatting || !AgentChat.busy);
    callback build(string);
    callback pointer-moved(length, length);
    forward-focus: input;
    changed active => { if (root.active) { input.focus(); } }
    changed focus-request => { if (root.active) { input.focus(); } }
    init => { if (root.active) { input.focus(); } }
    border-radius: Theme.radius-md; border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line-strong;
    background: Theme.surface-muted;
    function send() {
        if (!root.can-send) { return; }
        if (root.chatting) {
            AgentChat.send(root.draft);
            root.draft = "";
            input.focus();
        } else {
            root.build(root.draft);
        }
    }
    VerticalLayout {
        padding: 10px; padding-left: 13px; padding-right: 13px; spacing: 10px;
        field := Flickable {
            height: min(124px, max(48px, input.preferred-height + 6px));
            content-width: self.width;
            content-height: max(self.height, input.preferred-height + 6px);
            if root.draft == "": Text {
                x: 1px; y: 5px; width: parent.width - 2px;
                text: root.chatting ? "Message Angi…" : "Describe what you want to build…"; overflow: elide;
                font-size: Theme.text-label; font-family: "Noto Sans"; color: Theme.ink;
            }
            input := TextInput {
                x: 1px; y: 4px; width: parent.width - 2px; height: max(field.height - 6px, self.preferred-height);
                text <=> root.draft;
                single-line: false; wrap: word-wrap;
                font-family: "Noto Sans"; font-size: Theme.text-label; color: Theme.ink;
                selection-background-color: Theme.selection; selection-foreground-color: Theme.ink;
                accessible-label: root.chatting ? "Message Angi" : "Build prompt";
                key-pressed(event) => {
                    if (event.text == Key.Return && !event.modifiers.shift) { root.send(); return accept; }
                    reject
                }
                cursor-position-changed(position) => {
                    if (position.y + field.content-y < 0px) {
                        field.content-y = max(field.height - field.content-height, -position.y);
                    } else if (position.y + field.content-y > field.height - 25px) {
                        field.content-y = min(0px, max(field.height - field.content-height, field.height - position.y - 25px));
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            if AgentScope.mode == "os": AgentText {
                text: "ANGI system"; color: Theme.ink; font-size: Theme.text-small;
                vertical-alignment: center;
            }
            if AgentScope.mode != "os": AgentButton {
                property <string> folder: root.chatting ? AgentScope.chat-folder : AgentScope.project;
                width: root.chatting ? (folder == "" ? 130px : min(max(92px, root.width * 0.38), 285px))
                    : folder == "" ? root.control-width : min(max(root.control-width, root.width * 0.38), 285px, root.scope-controls-width - root.control-width);
                label: folder != "" ? folder : root.chatting ? "Home folder" : self.width < 120px ? "Folder…" : "Select folder…";
                action-label: root.chatting ? "Change Chat folder" : "Choose project folder";
                symbol: root.chatting || self.width >= 148px ? "▱" : ""; minimum: 33px;
                enabled: (!root.chatting || !AgentChat.busy) && !AgentScope.checking;
                activated => { AgentScope.choose-project(); }
            }
            if !root.chatting: AgentButton {
                width: root.control-width;
                minimum: 33px;
                label: AgentScope.single-agent ? (self.width >= 112px ? "Single agent" : "Single") : "Swarm";
                action-label: AgentScope.single-agent ? "Single agent selected. Switch to Swarm."
                    : "Swarm selected. Switch to Single agent.";
                highlighted: AgentScope.single-agent;
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
                activated => { AgentScope.single-agent = !AgentScope.single-agent; }
            }
            if root.chatting && AgentScope.chat-folder != "": AgentButton {
                label: "Use Home"; width: 82px; minimum: 33px;
                enabled: !AgentChat.busy && !AgentScope.checking;
                activated => { AgentScope.chat-folder = ""; }
            }
            Rectangle { horizontal-stretch: 1; min-width: 0px; }
            if root.width >= 560px: Text {
                text: "Shift+Enter for a new line"; color: Theme.ink;
                font-size: Theme.text-small; font-family: "Noto Sans"; vertical-alignment: center;
            }
            send-button := AgentButton {
                label: root.chatting ? "Send" : "Build";
                icon: Icons.arrow-up;
                icon-only: !root.chatting;
                symbol: root.chatting ? "↑" : "";
                width: root.chatting ? 78px : 33px;
                minimum: 33px; primary: true; enabled: root.can-send;
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
                activated => { build-dwell.dismiss(); root.send(); }
            }
        }
        if AgentScope.mode == "project" && AgentScope.error != "": AgentText {
            text: AgentScope.error; color: Theme.danger; font-size: Theme.text-small; wrap: word-wrap;
        }
    }
    build-dwell := HoverDwell { hovered: !root.chatting && send-button.hovered; }
    HoverTip {
        shown: build-dwell.ready;
        text: send-button.label;
        width: 64px;
        x: send-button.absolute-position.x - root.absolute-position.x + send-button.width - self.width;
        // At the bottom of the panel, keep the tooltip above the action.
        y: send-button.absolute-position.y - root.absolute-position.y - self.height - Theme.space-2;
    }
}

export component AgentWorkspace inherits Rectangle {
    in property <bool> active;
    in property <length> body-offset;
    in property <length> body-width;
    in property <length> notice-height;
    out property <length> header-height: 62px;
    callback build(string);
    callback pointer-moved(length, length);
    property <bool> chatting: AgentScope.mode == "chat";
    property <bool> has-transcript: root.chatting && (AgentChat.messages.length > 0 || AgentChat.busy);
    property <int> composer-focus;
    // The size shows beside the button when there is room; the Memory view always shows it.
    property <bool> show-size: root.width >= 640px;
    background: Theme.surface;
    clip: true;

    function suggest(prompt: string) {
        if (root.chatting) { AgentChat.draft = prompt; }
        else if (AgentScope.mode == "project") { AgentScope.project-draft = prompt; }
        else { AgentScope.os-draft = prompt; }
        root.composer-focus += 1;
    }

    header := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.header-height;
        background: Theme.surface;
        Rectangle { width: parent.width; height: 1px; y: parent.height - self.height; background: Theme.line-strong; }
        history-toggle := AgentButton {
            x: parent.width < 500px ? 8px : 20px; y: 13px; width: 35px; height: 36px;
            label: AgentHistory.open ? "Close history" : "Conversation history";
            icon-only: true; brand-mark: true; highlighted: AgentHistory.open;
            activated => {
                history-dwell.dismiss();
                AgentProviders.open = false;
                AgentKnowledge.open = false;
                AgentHistory.toggle();
            }
        }
        history-dwell := HoverDwell { hovered: history-toggle.hovered; }
        scope := ModeSwitch {
            x: parent.width < 500px ? 52px : parent.width < 600px ? 64px : (parent.width - self.width) / 2;
            y: 14px; height: 34px;
            width: parent.width < 370px ? clamp(parent.width - 241px, 90px, 126px) : parent.width < 600px ? 165px : 236px;
        }
        HorizontalLayout {
            x: parent.width - self.width - (parent.width < 500px ? 8px : 20px);
            y: 13px; width: (root.chatting ? (parent.width < 370px ? 88px : 100px) : 0px) + 78px + (root.show-size ? 62px : 0px); height: 36px;
            spacing: 8px;
            if root.chatting: AgentButton {
                width: root.width < 370px ? 80px : 92px;
                label: "New chat";
                enabled: !AgentChat.busy && !AgentHistory.loading;
                activated => {
                    AgentChat.new-chat();
                    AgentChat.draft = "";
                    root.composer-focus += 1;
                }
            }
            if root.show-size: Text {
                width: 54px; text: AgentKnowledge.size; color: Theme.ink-muted; font-size: Theme.text-small;
                horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                accessible-role: text; accessible-label: "Memory size " + AgentKnowledge.size;
            }
            memory := AgentButton {
                width: 35px;
                label: AgentKnowledge.open ? "Close memory" : "What ANGI remembers";
                icon: Icons.graph; icon-only: true; highlighted: AgentKnowledge.open;
                activated => {
                    memory-dwell.dismiss();
                    AgentHistory.open = false;
                    AgentProviders.open = false;
                    AgentKnowledge.toggle();
                }
            }
            providers := AgentButton {
                width: 35px;
                label: AgentProviders.open ? "Close AI providers" : "AI providers";
                symbol: "✦"; icon-only: true; highlighted: AgentProviders.open;
                activated => {
                    provider-dwell.dismiss();
                    AgentHistory.open = false;
                    AgentKnowledge.open = false;
                    AgentProviders.toggle();
                }
            }
        }
        provider-dwell := HoverDwell { hovered: providers.hovered; }
        memory-dwell := HoverDwell { hovered: memory.hovered; }
    }

    body := Rectangle {
        x: root.body-offset; y: root.header-height + root.notice-height;
        width: root.body-width; height: max(0px, root.height - self.y);
        clip: true;
        property <length> inset: self.width >= 600px ? 28px : 12px;
        VerticalLayout {
            width: max(0px, min(752px, parent.width - parent.inset * 2));
            x: (parent.width - self.width) / 2;
            height: parent.height; padding-bottom: parent.height < 520px ? 11px : 25px;
            spacing: 8px;
            Rectangle {
                vertical-stretch: 1; min-height: 0px;
                if !root.has-transcript: AgentWelcome {
                    width: parent.width; height: parent.height;
                    suggest(prompt) => { root.suggest(prompt); }
                }
                if root.has-transcript: ChatMessages { width: parent.width; height: parent.height; }
            }
            if root.chatting: AgentComposer {
                draft <=> AgentChat.draft; active: root.active; focus-request: root.composer-focus; vertical-stretch: 0;
            }
            if AgentScope.mode == "os": AgentComposer {
                draft <=> AgentScope.os-draft; active: root.active; focus-request: root.composer-focus; vertical-stretch: 0;
                build(prompt) => { root.build(prompt); }
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
            }
            if AgentScope.mode == "project": AgentComposer {
                draft <=> AgentScope.project-draft; active: root.active; focus-request: root.composer-focus; vertical-stretch: 0;
                build(prompt) => { root.build(prompt); }
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
            }
        }
    }

    ScopeTip {
        hint: scope.hint;
        width: min(330px, root.width - 18px);
        x: clamp(scope.x, 9px, root.width - self.width - 9px);
        y: scope.y + scope.height + 8px;
    }
    HoverTip {
        shown: memory-dwell.ready;
        width: 170px;
        x: max(8px, memory.absolute-position.x - root.absolute-position.x + memory.width - self.width);
        y: memory.absolute-position.y - root.absolute-position.y + memory.height + 8px;
        text: memory.label;
    }
    HoverTip {
        shown: provider-dwell.ready;
        width: 157px;
        x: max(8px, providers.absolute-position.x - root.absolute-position.x + providers.width - self.width);
        y: providers.absolute-position.y - root.absolute-position.y + providers.height + 8px;
        text: providers.label;
    }
    HoverTip {
        shown: history-dwell.ready;
        width: min(174px, root.width - 18px);
        x: clamp(history-toggle.x, 9px, root.width - self.width - 9px);
        y: history-toggle.y + history-toggle.height + 8px;
        text: history-toggle.label;
    }
}
