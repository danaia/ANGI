import { Theme } from "data.slint";

// ANGI's knowledge graph as the desktop shows it. The graph lives in ANGI's agent runtime, not in any AI
// provider; `agent_knowledge.rs` keeps these properties current and routes every edit back to it.
export struct KnowledgeNode {
    id: int, kind: string, name: string, summary: string, when: string,
    pinned: bool, edited: bool, source: string, links: int,
}
export struct KnowledgeLink { id: int, kind: string, name: string, relation: string, outgoing: bool }
export struct KnowledgeEvent { when: string, text: string }
export struct KnowledgeUse { when: string, mode: string, names: string }
export struct KnowledgeDetail {
    node: KnowledgeNode, created: string, events: [KnowledgeEvent], links: [KnowledgeLink],
}

export global KnowledgeKind {
    public pure function label(kind: string) -> string {
        kind == "project" ? "Project" : kind == "system" ? "System" : kind == "conversation" ? "Chat"
            : kind == "work" ? "Work" : kind == "topic" ? "Topic" : "Note"
    }
    public pure function tone(kind: string) -> color {
        kind == "project" ? Theme.ink : kind == "system" ? Theme.accent : kind == "conversation" ? Theme.success
            : kind == "work" ? Theme.warning : kind == "topic" ? Theme.ink-subtle : Theme.ink-muted
    }
    public pure function plural(kind: string) -> string {
        kind == "project" ? "Projects" : kind == "system" ? "System" : kind == "conversation" ? "Chats"
            : kind == "work" ? "Work" : kind == "topic" ? "Topics" : kind == "note" ? "Notes" : "All"
    }
    public pure function relation(name: string, outgoing: bool) -> string {
        name == "about" ? (outgoing ? "is about" : "has") : name == "mentions" ? (outgoing ? "mentions" : "mentioned in")
            : name == "changed" ? (outgoing ? "changed" : "changed by") : "related to"
    }
}

export global AgentKnowledge {
    in-out property <bool> open;
    // Requests still on their way to the runtime.
    in-out property <int> pending;
    in-out property <string> error;
    // False while ANGI is not recording anything or sharing anything with agents.
    in-out property <bool> enabled: true;
    // What the graph takes on disk, such as "412 KB", kept current by the runtime.
    in-out property <string> size: "0 B";
    in-out property <int> total;
    in-out property <string> counts;
    in-out property <[KnowledgeNode]> nodes;
    in-out property <[KnowledgeUse]> used;
    in-out property <int> selected: -1;
    in-out property <KnowledgeDetail> detail;
    callback reload(string, string);
    callback choose(int);
    callback edit(int, string, string);
    callback pin(int, bool);
    callback forget(int);
    callback unlink(int, int);
    callback add-note(string);
    callback set-enabled(bool);
    callback clear-all();
    public function toggle() {
        self.open = !self.open;
        if (self.open) { self.reload("", ""); }
    }
}
