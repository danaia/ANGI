import { Theme } from "data.slint";
import { ScrollView } from "std-widgets.slint";
import { TextField, Select } from "pebble/pebble.slint";
import { AgentButton, AgentText } from "agent-controls.slint";
export struct CardModels { orchestrator: string, builder: string, tester: string, os: string }
export global AgentProviders {
    in-out property <bool> open;
    in-out property <string> provider: "openai";
    in-out property <bool> connected;
    in-out property <bool> busy;
    in-out property <bool> watching;
    in-out property <string> status;
    in-out property <string> apple-address;
    in-out property <bool> apple-configured;
    // LM Studio is reached over Tailscale: its state, and whether sign-in can be offered.
    in-out property <string> tailscale;
    in-out property <bool> tailscale-ready;
    in-out property <bool> tailscale-login;
    in-out property <[string]> models;
    in-out property <string> orchestrator;
    in-out property <string> builder;
    in-out property <string> tester;
    // Chat retains the original model settings key (os).
    in-out property <string> os-updates;
    in-out property <string> single-agent;
    // Providers in display order. Only one service is active.
    out property <[string]> ids: ["apple", "openai", "lmstudio"];
    out property <[string]> names: ["Apple Intelligence", "OpenAI", "LM Studio"];
    in-out property <[bool]> ready: [false, false, false];
    in-out property <int> active-index: -1;
    // Models saved per provider, without the provider prefix.
    // Position of each role's saved model in `models` (-1 when none), for the drawer's dropdowns.
    in-out property <[int]> role-index: [-1, -1, -1, -1, -1];
    in-out property <[CardModels]> card-models: [{ orchestrator: "", builder: "", tester: "", os: "" }, { orchestrator: "", builder: "", tester: "", os: "" }, { orchestrator: "", builder: "", tester: "", os: "" }];
    callback action(int, string);
    callback save(string, string);
    callback open-link(string);
    public pure function index-of(provider: string) -> int {
        return provider == "apple" ? 0 : provider == "openai" ? 1 : 2;
    }
    public function show(provider: string) {
        self.provider = provider; self.open = true; self.connected = self.ready[self.index-of(provider)];
        self.models = []; self.status = "Checking connection…";
        self.action(0, "");
    }
    public function toggle() {
        if (self.open) { self.open = false; }
        else { self.show(self.active-index < 0 ? self.provider : self.ids[self.active-index]); }
    }
}
component RoleModel inherits VerticalLayout {
    in property <string> role;
    // What the person sees; the role is what is saved.
    in property <string> label;
    in property <string> selected;
    in property <int> index;
    spacing: 6px;
    AgentText { text: (root.label != "" ? root.label : root.role).to-uppercase(); color: Theme.ink; font-size: Theme.text-small; }
    AgentText { text: root.selected == "" ? "OpenCode default" : root.selected; color: Theme.accent; font-size: Theme.text-small; wrap: word-wrap; }
    Select {
        model: AgentProviders.models;
        current-index: root.index;
        enabled: !AgentProviders.busy && AgentProviders.models.length > 0;
        selected(value) => { AgentProviders.save(root.role, value); }
    }
}
export component ProviderPanel inherits FocusScope {
    forward-focus: close-button;
    init => { close-button.focus(); }
    key-pressed(event) => {
        if (event.text == Key.Escape) { AgentProviders.open = false; return accept; }
        reject
    }
    Rectangle {
        background: Theme.surface;
        clip: true;
        TouchArea { }
        Rectangle { x: 0px; width: 1px; height: parent.height; background: Theme.line-strong; }
        VerticalLayout {
            padding: 18px; spacing: 14px;
            HorizontalLayout {
                spacing: 10px;
                AgentText { text: "AI providers"; font-size: Theme.text-title; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                close-button := AgentButton {
                    width: 36px; icon-only: true; symbol: "×"; label: "Close AI providers";
                    activated => { AgentProviders.open = false; }
                }
            }
            ScrollView {
                VerticalLayout {
                    alignment: start; spacing: 16px; padding-right: 8px;
                    VerticalLayout {
                        spacing: 7px;
                        for name[index] in AgentProviders.names: AgentButton {
                            property <bool> in-use: AgentProviders.active-index == index;
                            label: name;
                            symbol: in-use ? "●" : "○";
                            detail: index == 0 && AgentProviders.apple-configured && !AgentProviders.ready[index]
                                ? (in-use ? "Active · Disconnected" : "Disconnected")
                                : in-use ? (AgentProviders.card-models[index].os == "" ? "Active · Default model"
                                : "Active · " + AgentProviders.card-models[index].os)
                                : AgentProviders.ready[index] ? "Connected" : "Set up";
                            highlighted: AgentProviders.provider == AgentProviders.ids[index];
                            minimum: 49px;
                            activated => { AgentProviders.show(AgentProviders.ids[index]); }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line-strong; }
                    AgentText { text: AgentProviders.status; color: Theme.ink; font-size: Theme.text-body-sm; wrap: word-wrap; }
                    if AgentProviders.provider == "apple": VerticalLayout {
                        alignment: start; spacing: 12px;
                        AgentButton { minimum: 36px; vertical-stretch: 0; label: "Open Local LLM Server in the App Store"; activated => { AgentProviders.open-link("https://apps.apple.com/us/app/local-llm-server/id6757007308"); } }
                        AgentText { text: "Use the network address shown by the app, not localhost. Apple Intelligence must be enabled and its model downloaded on the Apple device."; color: Theme.ink; font-size: Theme.text-small; wrap: word-wrap; }
                        endpoint := TextField { height: 36px; vertical-stretch: 0; placeholder-text: "http://your-device-address:port/v1"; text <=> AgentProviders.apple-address; }
                        AgentButton { minimum: 36px; vertical-stretch: 0; label: "Test and connect"; enabled: !AgentProviders.busy && endpoint.text != ""; activated => { AgentProviders.action(2, endpoint.text); } }
                    }
                    if AgentProviders.provider == "openai" && !AgentProviders.connected: VerticalLayout {
                        alignment: start; spacing: 12px;
                        AgentText { text: "Sign in in the browser window. Once this panel says Connected, you can close the browser. Closing the browser alone does not complete authentication."; color: Theme.ink; font-size: Theme.text-small; wrap: word-wrap; }
                        AgentButton { minimum: 36px; vertical-stretch: 0; label: "Sign in with ChatGPT"; enabled: !AgentProviders.busy; activated => { AgentProviders.action(1, ""); } }
                    }
                    if AgentProviders.provider == "lmstudio": VerticalLayout {
                        alignment: start; spacing: 12px;
                        AgentText { text: AgentProviders.tailscale; color: AgentProviders.tailscale-ready ? Theme.success : Theme.warning; font-size: Theme.text-small; wrap: word-wrap; }
                        if AgentProviders.tailscale-login: AgentButton { minimum: 36px; vertical-stretch: 0; label: "Sign in to Tailscale"; enabled: !AgentProviders.busy; activated => { AgentProviders.action(5, ""); } }
                        AgentText { text: "In LM Studio, load a model, start the server and turn on Serve on local network. Then enter that computer's Tailscale name or address."; color: Theme.ink; font-size: Theme.text-small; wrap: word-wrap; }
                        lm-endpoint := TextField { height: 36px; vertical-stretch: 0; placeholder-text: "your-computer or 100.x.y.z:1234"; }
                        AgentButton { minimum: 36px; vertical-stretch: 0; label: AgentProviders.connected ? "Test and update" : "Test and connect"; enabled: !AgentProviders.busy && AgentProviders.tailscale-ready && lm-endpoint.text != ""; activated => { AgentProviders.action(6, lm-endpoint.text); } }
                    }
                    if AgentProviders.connected && AgentProviders.active-index != AgentProviders.index-of(AgentProviders.provider): VerticalLayout {
                        alignment: start; spacing: 12px;
                        AgentButton { minimum: 36px; vertical-stretch: 0; label: "Use " + AgentProviders.names[AgentProviders.index-of(AgentProviders.provider)] + " for Agent Angi"; enabled: !AgentProviders.busy; activated => { AgentProviders.action(3, ""); } }
                        AgentText {
                            text: AgentProviders.active-index < 0 ? "Agent Angi builds with one service at a time." : "Agent Angi currently builds with " + AgentProviders.names[AgentProviders.active-index] + ". Using this service switches new builds to it.";
                            color: Theme.ink; font-size: Theme.text-small; wrap: word-wrap;
                        }
                    }
                    if AgentProviders.connected && AgentProviders.active-index == AgentProviders.index-of(AgentProviders.provider)
                        && (!AgentProviders.busy || AgentProviders.models.length > 0): VerticalLayout {
                        alignment: start; spacing: 18px;
                        AgentText { text: "Models"; color: Theme.ink; font-size: Theme.text-title; font-weight: 600; }
                        RoleModel { role: "os"; label: "Chat"; selected: AgentProviders.os-updates; index: AgentProviders.role-index[3]; }
                        RoleModel { role: "single"; label: "Single agent (OS and Project)"; selected: AgentProviders.single-agent; index: AgentProviders.role-index[4]; }
                        AgentText { text: "Swarm (OS and Project)"; color: Theme.ink; font-size: Theme.text-body; font-weight: 600; }
                        RoleModel { role: "orchestrator"; selected: AgentProviders.orchestrator; index: AgentProviders.role-index[0]; }
                        RoleModel { role: "builder"; selected: AgentProviders.builder; index: AgentProviders.role-index[1]; }
                        RoleModel { role: "tester"; selected: AgentProviders.tester; index: AgentProviders.role-index[2]; }
                        AgentText { text: "Each choice is saved immediately. Existing agent sessions keep their current models."; color: Theme.ink; font-size: Theme.text-small; wrap: word-wrap; }
                    }
                }
            }
            AgentButton { minimum: 36px; vertical-stretch: 0; label: "Refresh connection"; enabled: !AgentProviders.busy; activated => { AgentProviders.action(0, ""); } }
        }
    }
}
