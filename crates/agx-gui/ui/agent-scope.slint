import { Theme } from "data.slint";
import { HoverDwell, HoverTip } from "hover-tip.slint";
import { AgentText } from "agent-controls.slint";

// What Agent Angi does: build the operating system ("os"), build in one project folder ("project"),
// or talk and optionally work with local files ("chat").
//
// The project folder arrives through two callbacks only:
//   choose-project()   the user asked to pick a folder; agent_project.rs opens ANGI Files' picker.
//   use-project(path)  a folder was chosen by any means. The agent runtime validates it.
export global AgentScope {
    in-out property <string> mode: "os";
    in-out property <bool> single-agent;
    in-out property <string> project;
    in-out property <string> os-draft;
    in-out property <string> project-draft;
    in-out property <string> chat-folder;
    in-out property <bool> picker-for-chat;
    in-out property <string> error;
    in-out property <bool> checking;
    out property <bool> ready: mode != "project" || project != "";
    callback choose-project();
    callback use-project(string);
}

// Three-segment switch. Hovering a segment for a moment raises `hint` (0 = OS, 1 = Project, 2 = Chat),
// which the panel turns into a tooltip beside it.
export component ModeSwitch inherits Rectangle {
    out property <int> hint: -1;
    callback selected();
    property <[string]> modes: ["os", "project", "chat"];
    // Pebble Line segmented control: a `surface-muted` trough, the chosen segment a raised `surface` pill.
    width: 252px; height: 38px;
    border-radius: self.height / 2; border-width: Theme.stroke-hair;
    border-color: Theme.line;
    background: Theme.surface-muted;
    for label[index] in ["OS", "Project", "Chat"] : segment := Rectangle {
        x: 3px + index * (parent.width - 6px) / 3; y: 3px; width: (parent.width - 6px) / 3; height: parent.height - 6px;
        property <bool> selected: AgentScope.mode == root.modes[index];
        function select-mode() { AgentScope.mode = root.modes[index]; dwell.dismiss(); root.selected(); }
        border-radius: self.height / 2;
        background: selected ? Theme.surface : transparent;
        border-width: focus.has-focus ? Theme.stroke-focus : selected ? Theme.stroke-hair : 0px;
        border-color: focus.has-focus ? Theme.focus : Theme.line-strong;
        accessible-role: button;
        accessible-label: label;
        accessible-action-default => { self.select-mode(); }
        AgentText {
            text: label; font-family: Theme.font-sans; font-size: Theme.text-body-sm; font-weight: 500; horizontal-alignment: center; vertical-alignment: center;
            color: selected || pointer.has-hover ? Theme.ink : Theme.ink-muted;
        }
        focus := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") { segment.select-mode(); return accept; }
                reject
            }
            pointer := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { focus.focus(); segment.select-mode(); }
            }
        }
        dwell := HoverDwell {
            hovered: pointer.has-hover;
            changed ready => {
                if self.ready { root.hint = index; }
                else if root.hint == index { root.hint = -1; }
            }
        }
    }
}

export component ScopeTip inherits HoverTip {
    in property <int> hint;
    shown: root.hint >= 0;
    width: 330px;
    text: root.hint == 2
        ? "Chat: talk with Angi, browse folders, and save text files. Chat starts in your home folder."
        : root.hint == 1
        ? "Project: build your own software inside the folder you choose."
        : "OS: work on ANGI’s desktop, services, and system files.";
}
