import { Theme } from "data.slint";
import { ScrollView } from "std-widgets.slint";
import { AgentButton, AgentText } from "agent-controls.slint";

export struct WorkResource { label: string, path: string }
export struct WorkRecord {
    mode: string, title: string, brief: string, summary: string, summary-label: string,
    resources: [WorkResource],
}

export global AgentWork {
    in-out property <bool> open;
    in-out property <WorkRecord> record;
    in-out property <image> frame;
    in-out property <int> viewport-width;
    in-out property <int> viewport-height;
    in-out property <int> frame-width;
    in-out property <int> frame-height;
    in-out property <int> cursor;
    in-out property <bool> ready;
    in-out property <string> error;
    in-out property <string> dialog;
    callback open-folder(string);
    callback back();
    callback answer(bool);
    callback pointer(int, int, float, float, bool, bool, bool, bool);
    callback scroll(float, float, bool, bool, bool, bool);
    callback key(string, bool, bool, bool, bool, bool) -> bool;
}

export component WorkSummary inherits ScrollView {
    content-width: self.visible-width;
    VerticalLayout {
        padding-top: 24px; padding-bottom: 24px; padding-right: 8px;
        spacing: 16px; alignment: start;
        AgentText { text: AgentWork.record.title; font-size: Theme.text-heading-2; font-weight: 600; wrap: word-wrap; }
        AgentText { text: "Original request"; font-size: Theme.text-body; font-weight: 600; }
        AgentText { text: AgentWork.record.brief; font-size: Theme.text-body; color: Theme.ink; wrap: word-wrap; }
        AgentText {
            text: AgentWork.record.summary-label == "" ? "Outcome" : AgentWork.record.summary-label;
            font-size: Theme.text-body; font-weight: 600;
        }
        AgentText {
            text: AgentWork.record.summary == "" ? "No outcome was recorded for this run." : AgentWork.record.summary;
            font-size: Theme.text-body; color: Theme.ink; wrap: word-wrap;
        }
        if AgentWork.record.resources.length > 0: VerticalLayout {
            spacing: 8px; alignment: start;
            AgentText { text: "Resources"; font-size: Theme.text-body; font-weight: 600; }
            for resource in AgentWork.record.resources: AgentButton {
                label: resource.label; detail: resource.path; symbol: "↗"; minimum: 53px;
                action-label: "Open " + resource.label + " in Files: " + resource.path;
                activated => { AgentWork.open-folder(resource.path); }
            }
        }
    }
}
