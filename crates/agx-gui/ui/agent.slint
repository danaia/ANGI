import { Theme } from "data.slint";
import { Button } from "pebble/pebble.slint";

import { AgentProviders, CardModels, ProviderPanel } from "agent-providers.slint";
import { AgentScope } from "agent-scope.slint";
import { AgentChat, ChatMessage } from "agent-chat.slint";
import { AgentHistory, HistoryEntry, HistoryPanel } from "agent-history.slint";
import { AgentKnowledge, KnowledgeNode, KnowledgeLink, KnowledgeEvent, KnowledgeUse, KnowledgeDetail } from "agent-knowledge.slint";
import { KnowledgePanel } from "agent-knowledge-view.slint";
import { AgentWorkspace } from "agent-conversation.slint";
import { AgentWork } from "agent-work-summary.slint";
import { AgentWorkView } from "agent-work-view.slint";
export { AgentProviders, CardModels, AgentScope, AgentChat, ChatMessage, AgentHistory, HistoryEntry }
export { AgentKnowledge, KnowledgeNode, KnowledgeLink, KnowledgeEvent, KnowledgeUse, KnowledgeDetail }

export global AgentAngi {
    // Agents and swarms still running for this account, kept current by agent_swarm.rs. A swarm
    // keeps running after its terminal tab is closed, so the panel offers a way back to Herdr.
    in-out property <int> running-agents;
    in-out property <int> running-swarms;
    // True from the moment stopping is confirmed until the agents are gone.
    in-out property <bool> stopping;
    callback activate();
    callback submit(string);
    callback open-herdr();
    callback stop-agents();
}

component HerdrCta inherits Rectangle {
    // Stopping ends running work, so the button asks first.
    property <bool> confirming;
    height: 52px;
    border-radius: Theme.radius-md; border-width: 0px; background: Theme.surface-muted;
    border-color: root.confirming ? Theme.danger : AgentAngi.stopping ? Theme.warning : Theme.success;
    HorizontalLayout {
        padding-left: 14px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px; spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 2px;
            Text {
                text: AgentAngi.stopping ? "Stopping agents…" : root.confirming ? "Stop all \{AgentAngi.running-agents}?"
                    : AgentAngi.running-agents == 1 ? "1 agent running" : "\{AgentAngi.running-agents} agents running";
                color: AgentAngi.stopping ? Theme.warning : root.confirming ? Theme.danger : Theme.success;
                font-size: Theme.text-body-sm; font-weight: 600; overflow: elide;
            }
            if root.confirming && !AgentAngi.stopping: Text {
                text: "Ends their work. Files stay."; color: Theme.ink-muted; font-size: Theme.text-caption; overflow: elide;
            }
            if !root.confirming && !AgentAngi.stopping && AgentAngi.running-swarms > 1: Text {
                text: "\{AgentAngi.running-swarms} sessions · Herdr shows the newest"; color: Theme.ink-muted; font-size: Theme.text-caption; overflow: elide;
            }
        }
        if !root.confirming && !AgentAngi.stopping: HorizontalLayout {
            spacing: 8px;
            Button { text: "Open Herdr"; clicked => { AgentAngi.open-herdr(); } }
            Button { text: "Stop"; clicked => { root.confirming = true; } }
        }
        if root.confirming && !AgentAngi.stopping: HorizontalLayout {
            spacing: 8px;
            Button { text: "Stop all"; clicked => { root.confirming = false; AgentAngi.stop-agents(); } }
            Button { text: "Keep"; clicked => { root.confirming = false; } }
        }
    }
}

export component AgentPanel inherits Rectangle {
    in property <bool> active;
    callback pointer-moved(length, length);
    background: Theme.surface;
    property <length> drawer-width: min(420px, root.width - 12px);
    property <bool> docked-drawer: root.width >= 840px;
    property <bool> drawer-open: AgentProviders.open || AgentHistory.open;
    property <length> body-width: root.drawer-open && root.docked-drawer ? root.width - root.drawer-width : root.width;
    property <length> body-offset: AgentHistory.open && root.docked-drawer ? root.drawer-width : 0px;

    TouchArea {
        changed mouse-x => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        changed mouse-y => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { AgentAngi.activate(); } }
    }
    workspace := AgentWorkspace {
        width: root.width; height: root.height;
        visible: !AgentWork.open;
        body-width: root.body-width;
        body-offset: root.body-offset;
        notice-height: AgentAngi.running-agents > 0 ? 66px : 0px;
        active: root.active && !root.drawer-open && !AgentWork.open && !AgentKnowledge.open;
        build(prompt) => { AgentAngi.submit(prompt); }
        pointer-moved(x, y) => { root.pointer-moved(x, y); }
    }
    if !AgentWork.open && AgentAngi.running-agents > 0: HerdrCta {
        width: min(450px, max(0px, root.body-width - 24px));
        x: root.body-offset + root.body-width - self.width - 12px; y: workspace.header-height + 8px;
    }
    if !AgentWork.open && root.drawer-open && !root.docked-drawer: Rectangle {
        y: workspace.header-height; height: root.height - self.y;
        width: root.width; background: Theme.scrim;
        TouchArea { clicked => { AgentProviders.open = false; AgentHistory.open = false; } }
    }
    if AgentHistory.open: HistoryPanel {
        visible: !AgentWork.open;
        x: 0px; width: root.drawer-width;
        y: workspace.header-height; height: max(0px, root.height - self.y);
    }
    if !AgentWork.open && AgentProviders.open: ProviderPanel {
        x: root.width - root.drawer-width; width: root.drawer-width;
        y: workspace.header-height; height: max(0px, root.height - self.y);
    }
    if !AgentWork.open && AgentKnowledge.open: KnowledgePanel {
        x: 0px; width: root.width;
        y: workspace.header-height; height: max(0px, root.height - self.y);
    }
    if AgentWork.open: AgentWorkView {
        width: root.width; height: root.height;
        active: root.active;
        activate => { AgentAngi.activate(); }
        pointer-moved(x, y) => { root.pointer-moved(x, y); }
    }
}
