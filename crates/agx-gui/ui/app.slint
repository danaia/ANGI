// AGX desktop shell. The tiling engine lives in Rust (src/wm.rs); this file
// draws what it places and forwards raw keyboard and pointer input to it.
import { Theme, Sys, NetRow, HwRow, MenuRow, Win } from "data.slint";
import { OverviewPanel, CpuPanel, MemoryPanel, NetworkPanel, HardwarePanel, SystemPanel } from "panels.slint";
import { ServicesPanel, Services, ServiceRow } from "services.slint";
export { Services, ServiceRow }
import { ServiceUpdateDialog } from "services-dialog.slint";
import { ServiceUpdateProgress } from "services-progress.slint";
import { Web, WebOption, BookmarkItem, BookmarkRow, BrowserPanel, BrowserTabs, BookmarkChrome, BookmarkMenus } from "browser.slint";
export { Web, WebOption, BookmarkItem, BookmarkRow }
import { Terminal, TerminalRow, TerminalRun, TerminalPanel, TerminalView } from "terminal.slint";
export { Terminal, TerminalRow, TerminalRun, TerminalView }
import { BrowserPopup } from "browser-popup.slint";
import { DesktopInput } from "desktop-input.slint";
import { StorageView, StorageCell, StorageTrashRow } from "storage.slint";
import { EmptyTrashDialog } from "storage-trash.slint";
import { DriveMount, DriveMountDialog } from "drive-mount.slint";
export { DriveMount }
import { StorageDialog } from "storage-dialog.slint";
import { CacheDialog } from "cache-dialog.slint";
import { MemoryProcesses, ProcessRow, MemoryProcessDialog } from "memory-processes.slint";
export { MemoryProcesses, ProcessRow }
export { StorageView, StorageCell, StorageTrashRow }
import { AgentPanel, AgentAngi, AgentChat, AgentHistory, AgentProviders, AgentScope, CardModels, ChatMessage, HistoryEntry } from "agent.slint";
export { AgentAngi, AgentChat, AgentHistory, AgentProviders, AgentScope, CardModels, ChatMessage, HistoryEntry }
import { AgentWork, WorkRecord, WorkResource } from "agent-work-summary.slint";
export { AgentWork, WorkRecord, WorkResource }
import { FilesPanel, Files, FileRow, Crumb, PlaceRow, PaneState } from "files.slint";
import { FolderPicker } from "files-picker.slint";
export { Files, FileRow, Crumb, PlaceRow, PaneState }
import { SettingsPanel, MouseSettings, BluetoothSettings, BtDevice, BtApproval, AppearanceSettings } from "settings.slint";
export { MouseSettings, BluetoothSettings, BtDevice, BtApproval, AppearanceSettings }
import { AppLauncher } from "launcher.slint";
import { HoverTip } from "hover-tip.slint";
import { Cursor } from "cursor.slint";
import { CursorPreviewWindow } from "cursor-preview.slint";
export { CursorPreviewWindow }
import { Icons, Icon, Button, ButtonVariant, Badge, Tone, MenuItem, Floating, Dialog, Title, Hint } from "pebble/pebble.slint";
import { LoginWindow } from "login.slint";
import { GreeterSetup, WifiChoice } from "first-boot.slint";
export { LoginWindow, GreeterSetup, WifiChoice }
export { Theme, Sys, NetRow, HwRow, MenuRow, Win }

// Window tile in Pebble Line: an outlined `surface` card (radius-lg) with a 44px header.
// Metrics mirror wm.rs: HEADER (Theme.header), BORDER (Theme.frame-inset), BTN_W and BTN_INSET.
// The focused window takes a 1.5px `ink` stroke and a dot before its title; nothing else changes.
component HeaderGlyph inherits Rectangle {
    in property <image> icon;
    in property <bool> focused;
    width: Theme.header-button;
    Icon {
        source: root.icon;
        width: 16px; height: 16px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        color: root.focused ? Theme.ink : Theme.ink-muted;
    }
}
component WindowFrame inherits Rectangle {
    in property <Win> win;
    in property <bool> dragging;
    in property <int> cursor;
    in property <bool> hide-cursor;
    callback pointer(int, int, length, length, bool, bool, bool, bool);
    callback scroll(float, float, bool, bool, bool, bool);
    callback pointer-moved(length, length);
    clip: true;
    animate x, y, width, height { duration: root.dragging ? 0ms : 110ms; easing: ease-out; }
    border-radius: min(Theme.radius-lg, self.height / 2);
    // The stroke is this shape's fill showing around the inset ground below: a gradient for the
    // focused or drop-target window (Theme.focus-stroke), a flat hairline otherwise. A collapsed
    // window is only a header tall, so its focus stroke is a solid `ink-muted` all the way round.
    private property <length> stroke: win.focused || win.target ? Theme.stroke-rule : Theme.stroke-hair;
    background: !(win.focused || win.target) ? Theme.line
        : win.collapsed ? Theme.ink-muted
        : Theme.focus-stroke;
    Rectangle {
        x: root.stroke;
        y: root.stroke;
        width: parent.width - 2 * root.stroke;
        height: parent.height - 2 * root.stroke;
        border-radius: max(0px, root.border-radius - root.stroke);
        background: win.target ? Theme.surface-muted : Theme.surface;
    }
    Rectangle {
        x: Theme.frame-inset;
        y: Theme.frame-inset;
        width: parent.width - 2 * Theme.frame-inset;
        height: parent.height - 2 * Theme.frame-inset;
        VerticalLayout {
            Rectangle {
                height: Theme.header - Theme.frame-inset;
                HorizontalLayout {
                    padding-left: Theme.space-5;
                    padding-right: Theme.header-inset - Theme.frame-inset;
                    spacing: Theme.space-2;
                    if win.focused: VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.ink; }
                    }
                    Text {
                        text: win.kind == 7 ? Web.title : win.kind == 8 || win.kind >= 12 ? Terminal.windows[win.kind == 8 ? 0 : win.kind - 11].title : win.title;
                        color: win.focused ? Theme.ink : Theme.ink-muted;
                        font-weight: 500;
                        font-size: Theme.text-body;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    // Order matches wm::scene hit-testing from the right: Close, Full, Float.
                    HeaderGlyph { icon: win.floating ? Icons.tile : Icons.float; focused: win.focused; }
                    HeaderGlyph { icon: Icons.maximize; focused: win.focused; }
                    HeaderGlyph { icon: Icons.x; focused: win.focused; }
                }
            }
            if !win.collapsed: Rectangle { height: 1px; background: Theme.line; }
            if !win.collapsed: Rectangle {
                vertical-stretch: 1;
                clip: true;
                if win.kind == 3: NetworkPanel { }
                if win.kind == 4: HardwarePanel { }
                if win.kind == 6: SystemPanel { }
                if win.kind == 7: BrowserPanel { active: win.focused; }
                if win.kind == 8 || win.kind >= 12: TerminalPanel { active: win.focused; window-id: win.kind == 8 ? 0 : win.kind - 11; }
            }
        }
    }
    DesktopInput {
        cursor: root.cursor;
        hide-cursor: root.hide-cursor;
        pointer(k, b, x, y, c, a, s, m) => { root.pointer(k, b, x, y, c, a, s, m); }
        scroll(dx, dy, c, a, s, m) => { root.scroll(dx, dy, c, a, s, m); }
        pointer-moved(x, y) => { root.pointer-moved(x, y); }
    }
    if win.kind == 5 && !win.collapsed: ServicesPanel {
        x: Theme.frame-inset; y: Theme.header + 1px;
        width: max(0px, parent.width - 2 * Theme.frame-inset);
        height: max(0px, parent.height - Theme.header - 1px - Theme.frame-inset);
    }
    if win.kind == 7 && !win.collapsed: BrowserTabs {
        x: Theme.frame-inset; y: Theme.header;
        width: max(0px, parent.width - 2 * Theme.frame-inset); height: 36px;
        pointer-moved(x, y) => { root.pointer-moved(x, y); }
    }
    if win.kind == 7 && !win.collapsed: BookmarkChrome {
        x: Theme.frame-inset; y: Theme.header + 36px;
        width: max(0px, parent.width - 2 * Theme.frame-inset); height: 78px;
    }
    if win.kind == 7 && !win.collapsed && Web.menus.length > 0: BookmarkMenus {
        x: Theme.frame-inset; y: Theme.header + 114px;
        width: max(0px, parent.width - 2 * Theme.frame-inset); height: max(0px, parent.height - Theme.header - 114px - Theme.frame-inset);
    }
    if win.kind == 2 && !win.collapsed: MemoryPanel {
        x: Theme.frame-inset; y: Theme.header + 1px;
        width: max(0px, parent.width - 2 * Theme.frame-inset);
        height: max(0px, parent.height - Theme.header - 1px - Theme.frame-inset);
        pointer-moved(x, y) => { root.pointer-moved(x, y); }
    }
    if win.kind == 1 && !win.collapsed: CpuPanel {
        x: Theme.frame-inset; y: Theme.header + 1px;
        width: max(0px, parent.width - 2 * Theme.frame-inset);
        height: max(0px, parent.height - Theme.header - 1px - Theme.frame-inset);
        cursor: root.cursor; hide-cursor: root.hide-cursor;
        pointer(k, b, x, y, c, a, s, m) => { root.pointer(k, b, x, y, c, a, s, m); }
        pointer-moved(x, y) => { root.pointer-moved(x, y); }
    }
    if win.kind == 0 && !win.collapsed: OverviewPanel {
        x: Theme.frame-inset; y: Theme.header + 1px;
        width: max(0px, parent.width - 2 * Theme.frame-inset);
        height: max(0px, parent.height - Theme.header - 1px - Theme.frame-inset);
        cursor: root.cursor; hide-cursor: root.hide-cursor;
        pointer(k, b, x, y, c, a, s, m) => { root.pointer(k, b, x, y, c, a, s, m); }
        pointer-moved(x, y) => { root.pointer-moved(x, y); }
    }
    if win.kind == 10 && !win.collapsed: AgentPanel {
        x: Theme.frame-inset; y: Theme.header + 1px;
        width: max(0px, parent.width - 2 * Theme.frame-inset);
        height: max(0px, parent.height - Theme.header - 1px - Theme.frame-inset);
        active: root.win.focused;
        pointer-moved(x, y) => {
            root.pointer(2, 3, x, y, false, false, false, false);
            root.pointer-moved(x, y);
        }
    }
    if win.kind == 11 && !win.collapsed: FilesPanel {
        x: Theme.frame-inset; y: Theme.header + 1px;
        width: max(0px, parent.width - 2 * Theme.frame-inset);
        height: max(0px, parent.height - Theme.header - 1px - Theme.frame-inset);
        active: root.win.focused;
        pointer-moved(x, y) => {
            root.pointer(2, 3, x, y, false, false, false, false);
            root.pointer-moved(x, y);
        }
    }
    if win.kind == 9 && !win.collapsed: SettingsPanel {
        x: Theme.frame-inset; y: Theme.header + 1px;
        width: max(0px, parent.width - 2 * Theme.frame-inset);
        height: max(0px, parent.height - Theme.header - 1px - Theme.frame-inset);
        active: root.win.focused;
        pointer-moved(x, y) => {
            root.pointer(2, 3, x, y, false, false, false, false);
            root.pointer-moved(x, y);
        }
    }

}

// One workspace pill in the top bar's segmented trough. Occupied workspaces read in `ink`, empty ones
// in `ink-subtle`; the current one is the raised `surface` pill.
component WorkspaceButton inherits Rectangle {
    in property <int> index;
    in property <bool> active;
    in property <bool> occupied;
    callback picked();
    callback pointer-moved(length, length);
    accessible-role: tab;
    accessible-label: "Workspace " + (root.index + 1);
    accessible-item-selected: root.active;
    width: 30px;
    border-radius: self.height / 2;
    background: root.active ? Theme.surface : transparent;
    border-width: Theme.stroke-hair;
    border-color: root.active ? Theme.line-strong : transparent;
    Text {
        text: root.index + 1;
        color: root.active || touch.has-hover ? Theme.ink : root.occupied ? Theme.ink-muted : Theme.ink-subtle;
        font-size: Theme.text-body-sm;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        clicked => { root.picked(); }
    }
}

// Round, unoutlined icon button for the top bar.
component BarButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> open;
    in property <color> tint: Theme.ink-muted;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    callback pointer-moved(length, length);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    width: self.height;
    border-radius: self.height / 2;
    background: root.open ? Theme.surface-muted : touch.has-hover ? Theme.surface-hover : transparent;
    Icon {
        source: root.icon;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        color: touch.has-hover || root.open ? Theme.ink : root.tint;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        moved => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "ANGI";
    background: Theme.background;
    default-font-family: "Poppins";
    default-font-size: Theme.text-body;
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    forward-focus: root-keys;
    public function focus-desktop() { root-keys.focus(); }

    in property <[Win]> wins: [];
    in property <[bool]> ws-occupied: [false, false, false, false, false];
    in property <int> workspace: 0;
    in property <string> layout-name: "windowed";
    in property <string> focus-title: "";
    in property <string> mod-name: "Super";
    in property <bool> windowed-mode: true;
    property <bool> mode-tip: false;
    property <bool> top-bar-black: false;
    in property <string> clock: "";
    in property <string> date: "";
    in property <string> toast: "";
    in property <bool> screen-full: false;
    in property <bool> dragging: false;
    in property <int> cursor: 0;
    in property <bool> draw-cursor: false;
    in property <bool> resize-cursor-overlay: false;
    in-out property <length> cursor-x;
    in-out property <length> cursor-y;
    in-out property <bool> cursor-seen: false;
    in property <bool> ghost-visible: false;
    in property <length> ghost-x;
    in property <length> ghost-y;
    in property <length> ghost-w;
    in property <length> ghost-h;

    in-out property <bool> menu-open: false;
    in-out property <int> menu-index: 0;
    in-out property <int> menu-section: 0;
    in property <[MenuRow]> menu-rows: [];
    in-out property <string> confirm-text: "";
    in-out property <bool> session-open: false;
    in-out property <int> session-index: 0;
    property <bool> custom-resize-cursor: root.resize-cursor-overlay
        && !DriveMount.open && !Services.progress-open && !Services.review-open && !StorageView.selected-open && !MemoryProcesses.open && !Files.chooser-open && root.cursor >= 1 && root.cursor <= 5 && !root.menu-open && !root.session-open && root.confirm-text == "";

    callback key(string, bool, bool, bool, bool) -> bool;
    callback browser-key(string, bool, bool, bool, bool, bool) -> bool;
    callback pointer(int, int, length, length, bool, bool, bool, bool);
    callback scroll(float, float, bool, bool, bool, bool);
    callback resized(length, length);
    callback menu-show();
    callback workspace-select(int);
    callback menu-query(string);
    callback menu-accept(int);
    callback menu-remove(int);
    callback confirm(bool);
    callback session-action(int);
    callback layout-toggle();
    callback settings-open();

    function choose-session(index: int) {
        if (index == 0) { root.settings-open(); }
        else { root.session-action(index - 1); }
    }

    function track-cursor(x: length, y: length) {
        root.cursor-x = x;
        root.cursor-y = y;
        root.cursor-seen = true;
    }

    pure function key-name(t: string) -> string {
        t == Key.LeftArrow ? "left" : t == Key.RightArrow ? "right" : t == Key.UpArrow ? "up"
        : t == Key.DownArrow ? "down" : (t == Key.Tab || t == Key.Backtab) ? "tab" : t == " " ? "space"
        : t == Key.PageUp ? "pageup" : t == Key.PageDown ? "pagedown"
        : t == Key.Escape ? "escape" : t == Key.Return ? "enter" : t.to-lowercase()
    }

    root-keys := FocusScope {
        key-pressed(e) => {
            if DriveMount.open || Services.progress-open || Services.review-open || StorageView.empty-confirming || StorageView.selected-open || MemoryProcesses.open || Files.chooser-open { return accept; }
            if (root.session-open) {
                if (e.text == Key.Escape) { root.session-open = false; }
                if (e.text == Key.DownArrow) { root.session-index = mod(root.session-index + 1, 5); }
                if (e.text == Key.UpArrow) { root.session-index = mod(root.session-index + 4, 5); }
                if (e.text == Key.Return) { root.session-open = false; root.choose-session(root.session-index); }
                return accept;
            }
            if (root.confirm-text != "") {
                if (e.text == Key.Return) { root.confirm(true); }
                if (e.text == Key.Escape) { root.confirm(false); }
                return accept;
            }
            if (root.key(root.key-name(e.text), e.modifiers.control, e.modifiers.alt, e.modifiers.shift || e.text == Key.Backtab, e.modifiers.meta)) {
                return accept;
            }
            if (root.browser-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, true)) { return accept; }
            reject
        }
        key-released(e) => {
            if (!Services.progress-open && !Services.review-open && !StorageView.selected-open && !MemoryProcesses.open && !Files.chooser-open && !root.session-open && root.confirm-text == "" && root.browser-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, false)) { return accept; }
            reject
        }

        // Desk: windows, drag ghost, and the pointer layer that drives the engine.
        Rectangle {
            width: parent.width;
            height: parent.height;
            changed width => { root.resized(self.width, self.height); }
            changed height => { root.resized(self.width, self.height); }
            init => { root.resized(self.width, self.height); }

            DesktopInput {
                cursor: root.cursor;
                hide-cursor: root.draw-cursor || root.custom-resize-cursor;
                pointer(k, b, x, y, c, a, s, m) => { root.pointer(k, b, x, y, c, a, s, m); }
                scroll(dx, dy, c, a, s, m) => { root.scroll(dx, dy, c, a, s, m); }
                pointer-moved(x, y) => { root.track-cursor(x, y); }
            }
            for w in root.wins: WindowFrame {
                x: w.x;
                y: w.y;
                width: w.w;
                height: w.h;
                win: w;
                dragging: root.dragging;
                cursor: root.cursor;
                hide-cursor: root.draw-cursor || root.custom-resize-cursor;
                pointer(k, b, x, y, c, a, s, m) => { root.pointer(k, b, x, y, c, a, s, m); }
                scroll(dx, dy, c, a, s, m) => { root.scroll(dx, dy, c, a, s, m); }
                pointer-moved(x, y) => { root.track-cursor(x, y); }
            }
            if root.ghost-visible: Rectangle {
                x: root.ghost-x;
                y: root.ghost-y;
                width: root.ghost-w;
                height: root.ghost-h;
                border-radius: Theme.radius-lg;
                border-width: Theme.stroke-rule;
                border-color: Theme.ink;
                background: Theme.selection;
            }

        }

        // Top bar (hidden while a window is fullscreen): a `surface` pill with a faint stroke, holding
        // apps, workspaces and layout on the left, the clock in the middle and status on the right.
        if !root.screen-full: top-bar := Rectangle {
            x: Theme.gap-out;
            y: 12px;
            width: parent.width - 2 * Theme.gap-out;
            height: 44px;
            border-radius: self.height / 2;
            background: Theme.surface;
            border-width: Theme.stroke-hair;
            border-color: Theme.line;
            TouchArea {
                moved => { root.track-cursor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
            HorizontalLayout {
                padding: 4px;
                padding-right: 6px;
                spacing: Theme.space-2;
                BarButton {
                    icon: Icons.grid; label: "Open Applications";
                    open: root.menu-open;
                    tint: Theme.ink;
                    pointer-moved(x, y) => { root.track-cursor(x, y); }
                    clicked => { root.menu-show(); }
                }
                // Workspaces in a segmented trough.
                Rectangle {
                    border-radius: self.height / 2;
                    background: Theme.surface-muted;
                    border-width: Theme.stroke-hair;
                    border-color: Theme.line;
                    HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;
                        for occupied[i] in root.ws-occupied: WorkspaceButton {
                            index: i;
                            active: root.workspace == i;
                            occupied: occupied;
                            pointer-moved(x, y) => { root.track-cursor(x, y); }
                            picked => { root.workspace-select(i); }
                        }
                    }
                }
                mode-box := BarButton {
                    icon: root.windowed-mode ? Icons.float : Icons.tile;
                    label: root.windowed-mode ? "Switch to tiled mode" : "Switch to windowed mode";
                    open: !root.windowed-mode;
                    accessible-checkable: true;
                    accessible-checked: !root.windowed-mode;
                    pointer-moved(x, y) => { root.track-cursor(x, y); }
                    clicked => { root.mode-tip = false; root.layout-toggle(); root-keys.focus(); }
                    changed has-hover => {
                        mode-dwell.running = self.has-hover;
                        if (!self.has-hover) { root.mode-tip = false; }
                    }
                    mode-dwell := Timer { interval: 400ms; running: false; triggered => { self.running = false; root.mode-tip = true; } }
                }
                // Kept clear of the centred clock.
                Text { text: root.focus-title; color: Theme.ink-muted; font-size: Theme.text-body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; max-width: max(0px, root.width / 2 - 340px); }
                Rectangle { horizontal-stretch: 1; }
                // Status badges give way to the clock on narrow screens.
                if root.width >= 1100px: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        Badge { text: "CPU \{Math.round(Sys.cpu-percent)}%"; }
                        Badge { text: "Memory \{Math.round(Sys.mem-percent)}%"; }
                        Badge {
                            text: Sys.primary-ip;
                            tone: Sys.primary-ip == "no network" ? Tone.neutral : Tone.success;
                            dot: true;
                            max-width: 180px;
                        }
                    }
                }
                session-box := BarButton {
                    icon: Icons.user; label: "Session menu";
                    open: root.session-open;
                    tint: Theme.ink;
                    pointer-moved(x, y) => { root.track-cursor(x, y); }
                    clicked => {
                        root.session-open = !root.session-open;
                        root.session-index = 0;
                        root.menu-open = false;
                        root-keys.focus();
                    }
                }
            }
            // Clock, centred on the bar.
            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-2;
                Text { text: root.clock; color: Theme.ink; font-size: Theme.text-title; font-weight: 500; vertical-alignment: center; }
                if root.date != "" && root.width >= 900px: Text { text: root.date; color: Theme.ink-muted; font-size: Theme.text-body-sm; vertical-alignment: center; }
            }
            // Layout toggle tooltip, same pattern as the Agent Angi scope tip.
            HoverTip {
                shown: root.mode-tip;
                text: root.windowed-mode
                    ? "Windowed: windows float freely. Click to tile them (\{root.mod-name}+L)."
                    : "Tiled: windows fill the screen in a grid. Click to float them (\{root.mod-name}+L).";
                x: mode-box.absolute-position.x - top-bar.absolute-position.x;
                y: mode-box.absolute-position.y - top-bar.absolute-position.y + mode-box.height + 8px;
            }
        }

        // Hint line: quiet keyboard help, replaced by a toast when there is news.
        if !root.screen-full: Rectangle {
            y: parent.height - Theme.hint-bar;
            height: Theme.hint-bar;
            HorizontalLayout {
                padding-left: Theme.gap-out + Theme.space-2;
                padding-right: Theme.gap-out;
                Text {
                    text: root.toast != "" ? root.toast
                        : root.windowed-mode ? "\{root.mod-name} + Space  Apps     Double-click header  Collapse or restore     Drag header  Move     \{root.mod-name} + L  Tiled"
                        : "\{root.mod-name} + Space  Apps     + arrows  Focus     + Q  Close     + T  Float     + F  Full     + L  Windowed     + 1–5  Workspace";
                    color: root.toast != "" ? Theme.warning : Theme.ink-muted;
                    font-size: Theme.text-small;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        if Web.popup-visible && Web.popup-kind != 0: BrowserPopup {
            x: Web.popup-x; y: Web.popup-y; width: Web.popup-w; height: Web.popup-h;
            pointer-moved(x, y) => { root.track-cursor(x, y); }
        }
        if root.menu-open: AppLauncher {
            rows: root.menu-rows;
            selected <=> root.menu-index;
            section <=> root.menu-section;
            query(text) => { root.menu-query(text); }
            accepted(index) => {
                // Installing keeps the launcher open so more apps can be queued; anything else closes it.
                if !root.menu-rows[index].keeps-open {
                    root.menu-open = false;
                    root-keys.focus();
                }
                root.menu-accept(index);
            }
            remove(index) => { root.menu-remove(index); }
            dismissed => { root.menu-open = false; root-keys.focus(); }
            pointer-moved(x, y) => { root.track-cursor(x, y); }
        }

        // Session dropdown stays separate from the searchable window menu.
        if root.session-open: Rectangle {
            TouchArea {
                pointer-event(e) => { root.track-cursor(self.mouse-x, self.mouse-y); }
                moved => { root.track-cursor(self.mouse-x, self.mouse-y); }
                clicked => { root.session-open = false; root-keys.focus(); }
            }
            Floating {
                x: parent.width - self.width - Theme.gap-out;
                y: 64px;
                width: 248px;
                height: 5 * 40px + 2 * Theme.space-2 + 1px + 2 * Theme.space-2;
                VerticalLayout {
                    padding: Theme.space-2;
                    spacing: 0;
                    for item[i] in [
                        { label: "Settings", icon: Icons.settings },
                        { label: "Log out", icon: Icons.logout },
                        { label: "Open Terminal UI (TUI)", icon: Icons.terminal },
                        { label: "Reboot…", icon: Icons.refresh },
                        { label: "Shut down…", icon: Icons.power },
                    ]: VerticalLayout {
                        if i == 3: Rectangle {
                            height: 1px + 2 * Theme.space-2;
                            Rectangle { y: Theme.space-2; height: 1px; x: Theme.space-2; width: parent.width - 2 * Theme.space-2; background: Theme.line; }
                        }
                        MenuItem {
                            text: item.label;
                            icon: item.icon;
                            danger: i >= 3;
                            highlighted: root.session-index == i;
                            pointer-moved(x, y) => { root.track-cursor(x, y); }
                            clicked => { root.session-open = false; root-keys.focus(); root.choose-session(i); }
                        }
                    }
                }
            }
        }

        if Files.chooser-open: FolderPicker {
            pointer-moved(x, y) => { root.track-cursor(x, y); }
            dismissed => { root-keys.focus(); }
        }

        if DriveMount.open: DriveMountDialog {
            pointer-moved(x, y) => { root.track-cursor(x, y); }
            dismissed => { root-keys.focus(); }
        }

        if StorageView.selected-open && !StorageView.cache-open: StorageDialog {
            dismissed => { root-keys.focus(); }
            pointer-moved(x, y) => { root.track-cursor(x, y); }
        }
        if StorageView.empty-confirming: EmptyTrashDialog {
            dismissed => { root-keys.focus(); }
            pointer-moved(x, y) => { root.track-cursor(x, y); }
        }
        if StorageView.cache-open: CacheDialog {
            dismissed => { root-keys.focus(); }
            pointer-moved(x, y) => { root.track-cursor(x, y); }
        }

        if MemoryProcesses.open: MemoryProcessDialog {
            dismissed => { root-keys.focus(); }
            pointer-moved(x, y) => { root.track-cursor(x, y); }
        }

        if Services.review-open: ServiceUpdateDialog {
            dismissed => { root-keys.focus(); }
            pointer-moved(x, y) => { root.track-cursor(x, y); }
        }

        if Services.progress-open: ServiceUpdateProgress {
            dismissed => { root-keys.focus(); }
            pointer-moved(x, y) => { root.track-cursor(x, y); }
        }

        // Confirmation dialog for disruptive actions.
        if root.confirm-text != "": Dialog {
            card-width: 460px;
            card-height: 236px;
            scrim-pointer(x, y) => {
                root.cursor-x = x;
                root.cursor-y = y;
                root.cursor-seen = true;
            }
            VerticalLayout {
                padding: Theme.space-8;
                spacing: Theme.space-3;
                Title { text: root.confirm-text; }
                Hint { text: "Enter confirms. Esc cancels."; vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-3;
                    Button { text: "Cancel"; variant: ButtonVariant.ghost; clicked => { root.confirm(false); } }
                    Button { text: "Confirm"; variant: ButtonVariant.primary; clicked => { root.confirm(true); } }
                }
            }
        }

        if (root.draw-cursor || root.custom-resize-cursor) && root.cursor-seen: Cursor {
            x: root.cursor-x;
            y: root.cursor-y;
            shape: root.menu-open || root.confirm-text != "" ? 0 : root.cursor;
        }
    }
}
