import { Theme } from "data.slint";

// Shared overlay for software rendering and LinuxKMS move/resize feedback.
export component Cursor inherits Rectangle {
    in property <int> shape;
    in property <bool> light-surface: Theme.surface.red * 0.2126 + Theme.surface.green * 0.7152 + Theme.surface.blue * 0.0722 > 145;
    // Preview uses the same asset and geometry at 3×; desktop remains 1×.
    in property <float> magnification: 1;
    width: 22px;
    height: 22px;
    // Arrow: tip at the pointer. The others are centred on it.
    if root.shape == 0 || root.shape == 6: Path {
        x: 0; y: 0; width: 14px; height: 20px;
        viewbox-width: 14; viewbox-height: 20;
        commands: "M 0 0 L 0 16 L 4 12.5 L 7 19 L 9.5 18 L 6.5 11.5 L 11.5 11.5 Z";
        fill: #ffffff; stroke: #000000; stroke-width: 1px;
    }
    if root.shape == 7: Path {
        x: -4px; y: -9px; width: 8px; height: 18px;
        viewbox-width: 8; viewbox-height: 18;
        commands: "M 0 0 L 8 0 M 4 0 L 4 18 M 0 18 L 8 18";
        fill: transparent; stroke: #ffffff; stroke-width: 4px;
    }
    if root.shape == 7: Path {
        x: -4px; y: -9px; width: 8px; height: 18px;
        viewbox-width: 8; viewbox-height: 18;
        commands: "M 0 0 L 8 0 M 4 0 L 4 18 M 0 18 L 8 18";
        fill: transparent; stroke: #000000; stroke-width: 2px;
    }
    if root.shape >= 1 && root.shape <= 5: Image {
        x: -12px * root.magnification; y: -12px * root.magnification;
        width: 24px * root.magnification; height: 24px * root.magnification;
        source: root.light-surface
            ? (root.shape == 1 ? @image-url("cursors/move-light.svg")
                : root.shape == 2 ? @image-url("cursors/ew-resize-light.svg")
                : root.shape == 3 ? @image-url("cursors/ns-resize-light.svg")
                : root.shape == 4 ? @image-url("cursors/nwse-resize-light.svg")
                : @image-url("cursors/nesw-resize-light.svg"))
            : root.shape == 1 ? @image-url("cursors/move.svg")
            : root.shape == 2 ? @image-url("cursors/ew-resize.svg")
            : root.shape == 3 ? @image-url("cursors/ns-resize.svg")
            : root.shape == 4 ? @image-url("cursors/nwse-resize.svg")
            : @image-url("cursors/nesw-resize.svg");
    }
}

