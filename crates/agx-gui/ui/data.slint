// Live system data shared by the desktop. The theme lives in pebble/tokens.slint (Pebble Line)
// and is re-exported here for existing imports.
import { Theme } from "pebble/tokens.slint";
export { Theme }

export struct NetRow { name: string, state: string, mac: string, ipv4: string }
export struct HwRow { kind: string, name: string, state: string, detail: string }
// state: 0 plain row; for installable packages 1 available, 2 queued, 3 installing, 4 installed, 5 update ready, 6 failed.
// progress is 0..1 while installing; action names what Enter does; keeps-open leaves the launcher up (installs queue).
export struct MenuRow { label: string, description: string, hint: string, icon: int, app: bool, running: bool,
    state: int, progress: float, action: string, keeps-open: bool, removable: bool,
    // top: where the row starts in the list; heading: a section title drawn above the row; badge: e.g. "Recommended".
    top: length, heading: string, badge: string }
// One window on the current workspace, already placed by the tiling engine.
export struct Win {
    kind: int,
    title: string,
    x: length,
    y: length,
    w: length,
    h: length,
    focused: bool,
    floating: bool,
    collapsed: bool,
    target: bool,
}


export global Sys {
    in property <string> hostname: "agx";
    in property <string> board;
    in property <string> kernel;
    in property <string> uptime;
    in property <string> warnings;
    in property <string> mode-note;
    in property <string> screen-size;
    in property <string> primary-ip: "no network";
    in property <float> cpu-percent;
    in property <string> cpu-detail;
    in property <string> cpu-temperature: "Unavailable";
    in property <int> network-risk-score: -1;
    in property <string> network-risk-reason: "Waiting for local socket data.";
    in property <string> load-text;
    in property <float> mem-percent;
    in property <string> mem-detail;
    in property <float> disk-percent;
    in property <string> disk-detail;
    in property <[NetRow]> networks;
    in property <[HwRow]> hardware;
}
