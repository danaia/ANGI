import { Theme } from "data.slint";
import { Button, Select } from "pebble/pebble.slint";

export global DriveMount {
    in-out property <bool> open;
    in property <bool> busy;
    in property <string> message;
    in property <[string]> partitions;
    in property <[string]> partition-ids;
    in property <[string]> drives;
    in property <[string]> drive-ids;
    callback show-picker();
    callback apply(int, bool);
}

export component DriveMountDialog inherits Rectangle {
    callback dismissed();
    callback pointer-moved(length, length);
    property <bool> formatting;
    property <int> confirmed-index: -1;
    property <string> confirmed-drive;
    property <bool> confirming: root.confirmed-index >= 0;
    background: #0008;

    TouchArea {
        moved => { root.pointer-moved(self.mouse-x, self.mouse-y); }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(540px, parent.width - 32px);
        height: layout.preferred-height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line-strong;
        border-radius: Theme.radius-xl;
        layout := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text {
                text: root.confirming ? "Erase and Mount NVMe Drive" :
                      root.formatting ? "Quick Format NVMe Drive" : "Mount External Drive";
                font-size: Theme.text-title;
                font-weight: 500;
                color: Theme.ink;
            }
            Text {
                text: root.confirming ?
                    "All partitions and files on " + root.confirmed-drive + " will be lost. ANGI will create a new ext4 partition and mount it now and at startup." :
                    root.formatting ?
                    "Choose the NVMe drive to erase and prepare for ANGI storage." :
                    "Choose an existing ext4 NVMe partition. ANGI will also mount it at startup.";
                wrap: word-wrap;
                color: Theme.ink;
            }
            selection := Select {
                visible: !root.confirming;
                accessible-label: root.formatting ? "NVMe drive" : "NVMe partition";
                model: root.formatting ? DriveMount.drives : DriveMount.partitions;
                enabled: !DriveMount.busy && self.model.length > 0;
                init => { self.focus(); }
            }
            if DriveMount.message != "" && (!root.formatting || root.confirming): Text {
                text: DriveMount.message;
                wrap: word-wrap;
                color: Theme.ink;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if root.confirming: Button {
                    text: "Erase and Mount";
                    enabled: !DriveMount.busy && root.confirmed-index < DriveMount.drives.length;
                    clicked => { DriveMount.apply(root.confirmed-index, true); }
                }
                close-button := Button {
                    text: root.confirming && DriveMount.drives.length == 0 ? "Close" : "Cancel";
                    enabled: !DriveMount.busy;
                    clicked => { DriveMount.open = false; root.dismissed(); }
                }
                back-button := Button {
                    text: "Back";
                    visible: root.formatting;
                    enabled: !DriveMount.busy && DriveMount.drives.length > 0;
                    clicked => {
                        if root.confirming {
                            root.confirmed-index = -1;
                        } else {
                            root.formatting = false;
                            selection.current-index = 0;
                        }
                        selection.focus();
                    }
                }
                if !root.formatting && DriveMount.drives.length > 0: Button {
                    text: "Quick Format…";
                    enabled: !DriveMount.busy;
                    clicked => {
                        root.formatting = true;
                        selection.current-index = 0;
                        selection.focus();
                    }
                }
                if !root.confirming: Button {
                    text: root.formatting ? "Continue" : "Mount";
                    enabled: !DriveMount.busy && selection.current-index >= 0 && selection.current-index < selection.model.length;
                    clicked => {
                        if root.formatting {
                            root.confirmed-drive = selection.model[selection.current-index];
                            root.confirmed-index = selection.current-index;
                            back-button.focus();
                        } else {
                            DriveMount.apply(selection.current-index, false);
                        }
                    }
                }
            }
        }
    }
}
