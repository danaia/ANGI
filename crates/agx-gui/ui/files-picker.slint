// Modal folder chooser built on the file browser. Project and Chat open it; the result
// goes back through AgentScope.use-project, where the agent runtime validates the folder.
import { Theme } from "data.slint";
import { Button, ButtonVariant } from "pebble/pebble.slint";
import { FileBrowser, Files } from "files.slint";
import { AgentScope } from "agent-scope.slint";

export component FolderPicker inherits FocusScope {
    callback dismissed();
    callback pointer-moved(length, length);
    forward-focus: browser;
    init => { browser.focus-list(); }
    function close() {
        if (!AgentScope.checking) { Files.chooser-open = false; Files.chooser-error = ""; root.dismissed(); }
    }
    Rectangle {
        background: Theme.scrim;
        TouchArea { moved => { root.pointer-moved(self.mouse-x, self.mouse-y); } }
        Rectangle {
            // Whole pixels only: a half-pixel origin softens every glyph inside the dialog.
            x: Math.floor((parent.width - self.width) / 2px) * 1px; y: Math.floor((parent.height - self.height) / 2px) * 1px;
            width: Math.floor(min(940px, parent.width - 32px) / 1px) * 1px; height: Math.floor(min(640px, parent.height - 32px) / 1px) * 1px;
            background: Theme.surface; border-radius: Theme.radius-xl; border-width: Theme.stroke-hair; border-color: Theme.line-strong;
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    VerticalLayout {
                        padding-left: 18px; padding-right: 18px; padding-top: 10px; spacing: 3px;
                        Text { text: AgentScope.picker-for-chat ? "Choose a folder for Chat" : "Choose a project folder"; color: Theme.ink; font-size: Theme.text-heading-2; font-weight: 500; }
                        Text { text: AgentScope.picker-for-chat ? "Chat can read and save text files and create folders here." : "Agent Angi will work only inside the folder you choose."; color: Theme.ink-muted; font-size: Theme.text-small; overflow: elide; }
                    }
                }
                browser := FileBrowser {
                    pane: 1; s: Files.chooser; picker: true; vertical-stretch: 1;
                    dismiss => { root.close(); }
                    pointer-moved(x, y) => { root.pointer-moved(x, y); }
                }
                Rectangle {
                    height: Files.chooser-error != "" ? 78px : 54px; background: Theme.surface;
                    VerticalLayout {
                        padding: 10px; padding-left: 18px; padding-right: 18px; spacing: 8px;
                        if Files.chooser-error != "": Text { text: Files.chooser-error; color: Theme.danger; font-size: Theme.text-small; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 10px; alignment: end;
                            Button { text: "Cancel"; enabled: !AgentScope.checking; clicked => { root.close(); } }
                            Button {
                                variant: ButtonVariant.primary;
                                text: AgentScope.checking ? "Checking…" : Files.chooser.single-folder ? "Choose selected folder" : "Choose this folder";
                                enabled: !AgentScope.checking;
                                clicked => { Files.command(1, "choose", ""); }
                            }
                        }
                    }
                }
            }
            // Drawn last so the opaque rows above cannot cover it.
            Rectangle { border-width: 0px; border-radius: Theme.radius-xl; }
        }
    }
}
