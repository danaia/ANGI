import { Theme } from "data.slint";
import { ScrollView } from "std-widgets.slint";
import { Button, ButtonVariant, Heading2, Hint, Label, Select, TextField } from "pebble/pebble.slint";
import { SecurityBody, SecuritySettings } from "security.slint";

export struct WifiChoice { id: string, security: int }

export global GreeterSetup {
    in-out property <int> step: 0;
    in-out property <bool> busy;
    in-out property <bool> ready;
    in-out property <bool> restart-required;
    in-out property <string> status;
    in-out property <string> error;
    in-out property <bool> wifi-available: true;
    in-out property <[string]> networks;
    in-out property <[WifiChoice]> wifi-choices;
    in-out property <string> hostname: "angi";
    callback scan(string);
    callback connect(string, int, string, int, string, bool);
    in-out property <[string]> driver-rows;
    callback prepare-drivers();
    callback restart-drivers();
    callback continue-setup(bool);
    callback create-account(string, string, string, string);
    // The account created in step 3; Finish signs in to it.
    in-out property <string> created-user;
    callback finish(string);
}

component WifiStep inherits VerticalLayout {
    property <string> country;
    property <int> selected: -1;
    property <bool> manual;
    property <string> manual-ssid;
    property <int> manual-security: 1;
    property <string> wifi-password;
    property <bool> password-needed: root.security-index == 1 || root.security-index == 2;
    property <int> security-index: root.manual || root.selected < 0 || root.selected >= GreeterSetup.wifi-choices.length
        ? root.manual-security : GreeterSetup.wifi-choices[root.selected].security;
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        region := TextField {
            text <=> root.country;
            placeholder-text: "Two-letter Wi-Fi country code";
            accessible-label: "Wi-Fi country code";
            init => { self.focus(); }
            enabled: !GreeterSetup.busy;
            accepted => { if (!GreeterSetup.busy) { GreeterSetup.scan(root.country); } }
        }
        Button {
            text: "Scan networks";
            enabled: !GreeterSetup.busy;
            clicked => { GreeterSetup.scan(root.country); }
        }
    }
    if !root.manual: Select {
        accessible-label: "Nearby Wi-Fi networks";
        model: GreeterSetup.networks;
        current-index <=> root.selected;
        enabled: !GreeterSetup.busy && GreeterSetup.networks.length > 0;
        selected => { root.wifi-password = ""; }
    }
    Button {
        text: root.manual ? "Choose a nearby network" : "Enter network name manually";
        enabled: !GreeterSetup.busy;
        clicked => { root.manual = !root.manual; root.wifi-password = ""; }
    }
    if root.manual: TextField {
        text <=> root.manual-ssid;
        placeholder-text: "Network name (SSID)";
        enabled: !GreeterSetup.busy;
        init => { self.focus(); }
    }
    if root.manual: Select {
        accessible-label: "Wi-Fi security";
        model: ["Open", "WPA / WPA2", "WPA3", "Enhanced open"];
        current-index <=> root.manual-security;
        enabled: !GreeterSetup.busy;
    }
    if root.password-needed && (root.manual || root.selected >= 0): TextField {
        text <=> root.wifi-password;
        placeholder-text: "Wi-Fi password";
        input-type: InputType.password;
        enabled: !GreeterSetup.busy;
    }
    Button {
        text: "Connect and save";
        enabled: !GreeterSetup.busy && (root.manual ? root.manual-ssid != "" : root.selected >= 0 && root.selected < GreeterSetup.networks.length);
        clicked => {
            GreeterSetup.connect(root.country, root.manual ? -1 : root.selected, root.manual-ssid,
                root.security-index, root.password-needed ? root.wifi-password : "", root.manual);
            root.wifi-password = "";
        }
    }
}

component AccountStep inherits VerticalLayout {
    spacing: 8px;
    name := TextField { placeholder-text: "Your name"; enabled: !GreeterSetup.busy; init => { self.focus(); } }
    username := TextField { placeholder-text: "Username"; enabled: !GreeterSetup.busy; }
    TextField { accessible-label: "Hostname"; placeholder-text: "Hostname"; text <=> GreeterSetup.hostname; enabled: !GreeterSetup.busy; }
    password := TextField { placeholder-text: "Password"; input-type: InputType.password; enabled: !GreeterSetup.busy; }
    confirm := TextField { placeholder-text: "Confirm password"; input-type: InputType.password; enabled: !GreeterSetup.busy; }
    Text {
        text: "Passwords do not match.";
        visible: confirm.text != "" && confirm.text != password.text;
        color: Theme.danger;
        wrap: word-wrap;
    }
    Button {
        text: "Create administrator";
        enabled: !GreeterSetup.busy && name.text != "" && username.text != ""
            && password.text != "" && password.text == confirm.text;
        clicked => {
            GreeterSetup.create-account(name.text, GreeterSetup.hostname, username.text, password.text);
            password.text = "";
            confirm.text = "";
        }
    }
}

export component FirstBootPanel inherits Rectangle {
    changed step => { SecuritySettings.active = self.step == 4; }
    property <int> step: GreeterSetup.step;
    Rectangle {
        width: min(660px, parent.width - 32px);
        height: min(600px, parent.height - 32px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius-xl;
        VerticalLayout {
            padding: parent.width < 500px ? Theme.space-4 : Theme.space-10;
            spacing: Theme.space-3;
            HorizontalLayout {
                alignment: space-between;
                Heading2 {
                    text: GreeterSetup.step == 1 ? (GreeterSetup.wifi-available ? "Connect to Wi-Fi" : "Connect to a network")
                        : GreeterSetup.step == 2 ? "Prepare drivers"
                        : GreeterSetup.step == 3 ? "Create your administrator account"
                        : GreeterSetup.step == 4 ? "Secure this computer" : "Checking this installation";
                    wrap: word-wrap;
                }
                Image {
                    width: 90px;
                    height: 32px;
                    source: @image-url("../../../brand/brand-mark-text.svg");
                    image-fit: contain;
                    accessible-label: "ANGI";
                }
            }
            ScrollView {
                vertical-stretch: 1;
                content-width: self.width;
                VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    if GreeterSetup.step == 1 && GreeterSetup.wifi-available: WifiStep {}
                    if GreeterSetup.step == 1 && !GreeterSetup.wifi-available: Hint {
                        text: "ANGI uses Ethernet automatically when connected. You can also continue setup offline.";
                        wrap: word-wrap;
                    }
                    if GreeterSetup.step == 2: VerticalLayout {
                        spacing: Theme.space-2;
                        Hint { text: "ANGI checks graphics, sound, Wi-Fi and Bluetooth before you create your account."; wrap: word-wrap; }
                        for row in GreeterSetup.driver-rows: Label { text: row; wrap: word-wrap; }
                        if !GreeterSetup.busy && !GreeterSetup.ready && !GreeterSetup.restart-required: Hint {
                            text: "You can finish setup, sign in as the administrator, and install drivers from Settings → Drivers.";
                            wrap: word-wrap;
                        }
                    }
                    if GreeterSetup.step == 3: AccountStep {}
                    if GreeterSetup.step == 4: SecurityBody { setup: true; compact: true; }
                    if GreeterSetup.status != "": Text {
                        text: GreeterSetup.status; color: Theme.ink; wrap: word-wrap;
                    }
                    if GreeterSetup.error != "": Text {
                        text: GreeterSetup.error; color: Theme.danger; wrap: word-wrap;
                    }
                }
            }
            if GreeterSetup.step >= 1: VerticalLayout {
                spacing: Theme.space-2;
                if GreeterSetup.step == 2 && !GreeterSetup.ready: HorizontalLayout {
                    alignment: end;
                    Button {
                        text: GreeterSetup.restart-required ? "Continue without restarting" : "Install drivers later";
                        enabled: !GreeterSetup.busy;
                        clicked => { GreeterSetup.continue-setup(true); }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.space-2;
                    if GreeterSetup.step == 2 || GreeterSetup.step == 3: Button {
                        text: "Back";
                        enabled: !GreeterSetup.busy;
                        clicked => {
                            GreeterSetup.error = "";
                            GreeterSetup.status = "";
                            GreeterSetup.step -= 1;
                        }
                    }
                    if GreeterSetup.step == 1 && GreeterSetup.wifi-available: Button {
                        text: "Use Ethernet or continue offline";
                        enabled: !GreeterSetup.busy;
                        clicked => { GreeterSetup.prepare-drivers(); }
                    }
                    if GreeterSetup.step == 1 && !GreeterSetup.wifi-available: Button {
                        text: "Continue";
                        variant: ButtonVariant.primary;
                        enabled: !GreeterSetup.busy;
                        init => { self.focus(); }
                        clicked => { GreeterSetup.prepare-drivers(); }
                    }
                    if GreeterSetup.step == 2 && !GreeterSetup.ready && !GreeterSetup.restart-required: Button {
                        text: "Retry";
                        enabled: !GreeterSetup.busy;
                        clicked => { GreeterSetup.prepare-drivers(); }
                    }
                    if GreeterSetup.step == 2 && GreeterSetup.restart-required: Button {
                        text: "Restart and check drivers";
                        variant: ButtonVariant.primary;
                        enabled: !GreeterSetup.busy;
                        init => { self.focus(); }
                        clicked => { GreeterSetup.restart-drivers(); }
                    }
                    if GreeterSetup.step == 2 && GreeterSetup.ready: Button {
                        text: "Continue";
                        variant: ButtonVariant.primary;
                        enabled: !GreeterSetup.busy;
                        init => { self.focus(); }
                        clicked => { GreeterSetup.continue-setup(false); }
                    }
                    if GreeterSetup.step == 4: Button {
                        text: "Finish";
                        variant: ButtonVariant.primary;
                        enabled: !SecuritySettings.busy;
                        clicked => { GreeterSetup.finish(GreeterSetup.created-user); }
                    }
                }
            }
        }
    }
}
