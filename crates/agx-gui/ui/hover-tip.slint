import { Theme } from "pebble/tokens.slint";

export component HoverDwell inherits Rectangle {
    in property <bool> hovered;
    out property <bool> ready: false;
    width: 0px;
    height: 0px;
    changed hovered => {
        dwell.running = root.hovered;
        if !root.hovered { root.ready = false; }
    }
    public function dismiss() {
        dwell.running = false;
        root.ready = false;
    }
    dwell := Timer {
        interval: 400ms;
        running: false;
        triggered => { self.running = false; root.ready = root.hovered; }
    }
}

// Pebble Line tooltip: solid `accent` with `on-accent` 12/500 text and a radius-xs corner. Flat, no
// stroke or shadow. See .agents/skills/angi-desktop-tooltips/SKILL.md for placement and timing.
export component HoverTip inherits Rectangle {
    in property <string> text;
    in property <bool> shown;
    visible: root.shown;
    width: 300px;
    height: words.preferred-height + 2 * 8px;
    background: Theme.accent;
    border-radius: Theme.radius-xs;
    words := Text {
        x: 12px;
        y: 8px;
        width: max(0px, parent.width - 24px);
        wrap: word-wrap;
        font-size: Theme.text-small;
        font-weight: 500;
        color: Theme.on-accent;
        text: root.text;
    }
}
