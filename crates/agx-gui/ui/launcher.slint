// Searchable launcher with Apps, Commands, Settings and Install tabs.
import { MenuRow } from "data.slint";
import { Theme, Icons, Icon, Badge, Kbd, SegmentedControl, Heading2, Hint, Caption } from "pebble/pebble.slint";
import { ScrollView } from "std-widgets.slint";

component AppIcon inherits Rectangle {
    in property <int> kind;
    // Pebble Line: every app icon is an ink outline in a `surface-muted` well; no per-app colour.
    out property <color> tint: Theme.ink;
    width: 42px;
    height: 42px;
    border-radius: Theme.radius-sm;
    background: Theme.surface-muted;
    Image {
        x: 9px; y: 9px; width: 24px; height: 24px;
        colorize: root.kind == 13 ? transparent : root.tint;
        source: root.kind == 0 ? @image-url("icons/apps/overview.svg")
            : root.kind == 1 ? @image-url("icons/apps/cpu.svg")
            : root.kind == 2 ? @image-url("icons/apps/storage.svg")
            : root.kind == 3 ? @image-url("icons/apps/network.svg")
            : root.kind == 4 ? @image-url("icons/apps/hardware.svg")
            : root.kind == 5 ? @image-url("icons/apps/services.svg")
            : root.kind == 6 ? @image-url("icons/apps/system.svg")
            : root.kind == 7 ? @image-url("icons/apps/console.svg")
            : root.kind == 8 ? @image-url("icons/apps/workspace.svg")
            : root.kind == 9 ? @image-url("icons/apps/window.svg")
            : root.kind == 10 ? @image-url("icons/apps/power.svg")
            : root.kind == 13 ? @image-url("icons/apps/opencode.svg")
            : root.kind == 12 ? @image-url("icons/apps/web.svg")
            : root.kind == 14 ? @image-url("icons/apps/system.svg")
            : root.kind == 15 ? @image-url("icons/apps/files.svg")
            : root.kind == 16 ? @image-url("icons/apps/applications.svg")
            : @image-url("icons/apps/logout.svg");
    }
}

component LauncherTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen();
    height: 32px;
    width: 112px;
    border-radius: self.height / 2;
    background: active ? Theme.surface-muted : touch.has-hover ? Theme.surface-hover : transparent;
    Text {
        text: root.label;
        color: root.active || touch.has-hover ? Theme.ink : Theme.ink-muted;
        font-size: Theme.text-body-sm;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.chosen(); }
    }
}

export component AppLauncher inherits Rectangle {
    in property <[MenuRow]> rows;
    in-out property <int> selected: 0;
    // Keep in step with APPS, COMMANDS, SETTINGS and INSTALL in launcher.rs.
    in-out property <int> section: 0;
    // Row waiting for a second click (or Delete) before an installed app is removed; -1 when none.
    private property <int> confirm-remove: -1;
    // Total height of the list: the last row's position plus its slot.
    private property <length> content-height: root.rows.length > 0 ? root.rows[root.rows.length - 1].top + 70px : 0px;
    callback query(string);
    callback accepted(int);
    callback remove(int);
    callback dismissed();
    callback pointer-moved(length, length);
    background: Theme.scrim;
    init => { search.focus(); }

    function choose() {
        if (root.selected >= 0 && root.selected < root.rows.length && root.rows[root.selected].state != 7) { root.accepted(root.selected); }
    }
    function switch-section(value: int) {
        root.section = value;
        root.selected = 0;
        results.content-y = 0px;
        root.query(search.text);
        search.focus();
    }
    function reveal-selection() {
        if (root.selected < 0 || root.selected >= root.rows.length) { return; }
        // The first row of a section brings its heading into view with it.
        let top = root.rows[root.selected].top - (root.rows[root.selected].heading != "" ? 34px : 0px);
        if (top + results.content-y < 0px) {
            results.content-y = -top;
        } else if (root.rows[root.selected].top + 64px + results.content-y > results.visible-height) {
            results.content-y = min(0px, results.visible-height - root.rows[root.selected].top - 64px);
        }
    }
    changed selected => { root.reveal-selection(); root.confirm-remove = -1; }
    Timer { interval: 4s; running: root.confirm-remove >= 0; triggered => { root.confirm-remove = -1; } }
    function try-remove(i: int) {
        if (i < 0 || i >= root.rows.length || !root.rows[i].removable) { return; }
        if (root.confirm-remove == i) { root.confirm-remove = -1; root.remove(i); }
        else { root.confirm-remove = i; }
    }

    TouchArea {
        pointer-event(e) => { root.pointer-moved(self.mouse-x, self.mouse-y); }
        clicked => { root.dismissed(); }
    }
    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(24px, min(72px, (parent.height - self.height) / 2));
        width: min(660px, parent.width - 40px);
        height: min(240px + max(70px, min(root.content-height, 8 * 70px + 68px)), parent.height - 64px);
        border-radius: Theme.radius-lg;
        background: Theme.surface;
        border-width: Theme.stroke-hair;
        border-color: Theme.line-strong;
        // Consume clicks in the panel; only the backdrop dismisses it.
        TouchArea { pointer-event(e) => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
        VerticalLayout {
            padding: Theme.space-6;
            padding-bottom: 0px;
            spacing: Theme.space-4;
            HorizontalLayout {
                height: 42px;
                spacing: 12px;
                AppIcon { kind: 0; }
                VerticalLayout {
                    spacing: 0px;
                    Heading2 { text: "Applications"; wrap: no-wrap; }
                    Hint { text: "Monitor, connect and manage your Pi."; wrap: no-wrap; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Kbd {
                        text: "Esc";
                        TouchArea { mouse-cursor: pointer; accessible-role: button; accessible-label: "Close launcher"; clicked => { root.dismissed(); } }
                    }
                }
            }
            Rectangle {
                height: 46px;
                border-radius: self.height / 2;
                background: Theme.surface;
                border-width: search.has-focus ? Theme.stroke-rule : Theme.stroke-hair;
                border-color: search.has-focus ? Theme.ink : Theme.line;
                HorizontalLayout {
                    padding-left: Theme.space-5; padding-right: Theme.space-4; spacing: Theme.space-3;
                    VerticalLayout { alignment: center; Icon { source: Icons.search; } }
                    Rectangle {
                        horizontal-stretch: 1;
                        Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "Search settings, apps or commands…"; visible: search.text == ""; color: Theme.ink-muted; font-size: Theme.text-body; horizontal-alignment: left; vertical-alignment: center; }
                        search := TextInput {
                            color: Theme.ink;
                            font-size: Theme.text-body;
                            selection-background-color: Theme.selection;
                            selection-foreground-color: Theme.ink;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            single-line: true;
                            accessible-label: "Search settings, apps or commands";
                            edited => { root.selected = 0; results.content-y = 0px; root.query(self.text); }
                            accepted => { root.choose(); }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) { root.dismissed(); return accept; }
                                if (e.text == Key.DownArrow) { root.selected = min(root.selected + 1, root.rows.length - 1); return accept; }
                                if (e.text == Key.UpArrow) { root.selected = max(root.selected - 1, 0); return accept; }
                                if (e.text == Key.PageDown) { root.selected = min(root.selected + 5, root.rows.length - 1); return accept; }
                                if (e.text == Key.PageUp) { root.selected = max(root.selected - 5, 0); return accept; }
                                if (e.text == Key.Delete && search.text == "") { root.try-remove(root.selected); return accept; }
                                if (e.text == Key.Tab) { root.switch-section(Math.mod(root.section + 1, 4)); return accept; }
                                if (e.text == Key.Backtab) { root.switch-section(Math.mod(root.section + 3, 4)); return accept; }
                                reject
                            }
                        }
                    }
                    if search.text != "": Rectangle {
                        width: 24px;
                        Icon { source: Icons.x; width: 16px; height: 16px; x: 4px; y: (parent.height - self.height) / 2; }
                        TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "Clear search";
                            clicked => { search.text = ""; root.selected = 0; results.content-y = 0px; root.query(""); search.focus(); }
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 42px; spacing: Theme.space-3;
                SegmentedControl {
                    label: "Launcher view";
                    options: ["Apps", "Commands", "Settings", "Install"];
                    current-index: root.section;
                    selected(index) => { root.switch-section(index); }
                    pointer-moved(x, y) => { root.pointer-moved(x, y); }
                }
                Rectangle { horizontal-stretch: 1; }
                if panel.width >= 620px: Caption {
                    text: search.text != "" ? "SEARCH RESULTS" : root.section == 0 ? "RUNS ON ANGI"
                        : root.section == 1 ? "DESKTOP & SESSION" : root.section == 2 ? "YOUR TOOLS" : "";
                    vertical-alignment: center;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                results := ScrollView {
                    content-height: root.content-height;
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: as-needed;
                    for row[i] in root.rows: Rectangle {
                        y: row.top;
                        height: 64px;
                        width: results.visible-width;
                        border-radius: Theme.radius-md;
                        background: i == root.selected ? Theme.surface-muted : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 14px; spacing: 13px;
                            VerticalLayout { width: 42px; alignment: center; AppIcon { kind: row.icon; } }
                            VerticalLayout {
                                padding-top: 12px; padding-bottom: 12px; spacing: 4px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: row.label; color: Theme.ink; font-size: Theme.text-label; font-weight: 500; overflow: elide; vertical-alignment: center; }
                                    if row.badge != "": VerticalLayout { alignment: center; Badge { text: row.badge; height: 20px; } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text { text: row.description; color: row.state == 6 ? Theme.danger : Theme.ink-muted; font-size: Theme.text-body-sm; overflow: elide; }
                            }
                            if row.removable && i == root.selected: Rectangle { width: 104px; }
                            if row.running: VerticalLayout {
                                width: 5px; alignment: center;
                                Rectangle { width: 5px; height: 5px; border-radius: 3px; background: Theme.success; }
                            }
                            Text {
                                text: row.hint; width: row.state == 0 ? 60px : 140px; horizontal-alignment: right;
                                color: row.state == 3 ? Theme.ink : row.state == 5 ? Theme.warning : row.state == 6 ? Theme.danger
                                    : row.running ? Theme.success : Theme.ink-muted;
                                font-size: Theme.text-small; vertical-alignment: center; overflow: elide;
                            }
                            Text { width: 18px; text: i == root.selected && (row.action != "" || row.state == 0) ? "↵" : ""; color: Theme.ink-muted; font-size: Theme.text-label; vertical-alignment: center; }
                        }
                        // A section's heading sits above its first row.
                        if row.heading != "": Text {
                            x: 12px; y: -26px; height: 20px; text: row.heading;
                            color: Theme.ink-muted; font-size: Theme.text-caption; letter-spacing: 0.5px; vertical-alignment: center;
                        }
                        // Live install progress along the bottom edge of the row.
                        if row.state == 3: Rectangle {
                            x: 16px; y: parent.height - 7px; width: parent.width - 32px; height: 4px; border-radius: 2px;
                            background: Theme.line;
                            Rectangle { x: 0px; width: parent.width * max(0.02, min(1.0, row.progress)); height: parent.height; border-radius: 2px; background: Theme.accent; }
                        }
                        TouchArea {
                            mouse-cursor: row.state == 7 ? MouseCursor.default : MouseCursor.pointer;
                            accessible-role: button;
                            accessible-enabled: row.state != 7;
                            accessible-label: row.label + ". " + row.description;
                            pointer-event(e) => {
                                root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                root.selected = i;
                            }
                            clicked => { root.selected = i; root.choose(); }
                        }
                        if row.removable && i == root.selected: Rectangle {
                            x: parent.width - 14px - 18px - 13px - 140px - 13px - 98px; y: (parent.height - self.height) / 2;
                            width: 98px; height: 30px; border-radius: self.height / 2;
                            background: root.confirm-remove == i ? Theme.danger-soft : remove-touch.has-hover ? Theme.surface-hover : Theme.surface;
                            border-width: Theme.stroke-hair; border-color: root.confirm-remove == i ? Theme.danger : Theme.line;
                            Text { text: root.confirm-remove == i ? "Confirm" : "Remove"; color: Theme.danger; font-size: Theme.text-small; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                            remove-touch := TouchArea {
                                mouse-cursor: pointer; accessible-role: button;
                                accessible-label: root.confirm-remove == i ? "Confirm removing " + row.label : "Remove " + row.label;
                                clicked => { root.try-remove(i); }
                            }
                        }
                    }
                }
                if root.rows.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text { text: root.section == 3 ? "No matching apps to install" : "No matching settings, apps or commands"; color: Theme.ink; font-size: Theme.text-label; font-weight: 500; horizontal-alignment: center; }
                    Text { text: root.section == 3 ? "Try searching by app name." : "Try network, btop, ripgrep or restart."; color: Theme.ink-muted; font-size: Theme.text-body-sm; horizontal-alignment: center; }
                }
            }
            Rectangle {
                height: 46px;
                border-width: 0px;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
                HorizontalLayout {
                    y: 1px;
                    height: parent.height - 1px;
                    spacing: 12px;
                    Text { text: "↑↓  Navigate"; color: Theme.ink-muted; font-size: Theme.text-small; vertical-alignment: center; }
                    if root.selected >= 0 && root.selected < root.rows.length && root.rows[root.selected].state != 7: Text {
                        text: "↵  " + (root.rows[root.selected].action != "" ? root.rows[root.selected].action
                            : root.rows[root.selected].state == 0 ? "Open" : "Working…");
                        color: Theme.ink-muted; font-size: Theme.text-small; vertical-alignment: center;
                    }
                    if root.selected >= 0 && root.selected < root.rows.length && root.rows[root.selected].removable && search.text == "": Text { text: "Del  Remove"; color: Theme.ink-muted; font-size: Theme.text-small; vertical-alignment: center; }
                    Text { text: "Tab  Switch view"; color: Theme.ink-muted; font-size: Theme.text-small; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.rows.length == 1 ? "1 result" : "\{root.rows.length} results"; color: Theme.ink-muted; font-size: Theme.text-small; vertical-alignment: center; }
                }
            }
        }
    }
}
