import { Theme } from "data.slint";
import { Cursor } from "cursor.slint";
import { FirstBootPanel, GreeterSetup } from "first-boot.slint";
import { Button, ButtonVariant, ControlSize, TextField, Icons, Heading2, Hint } from "pebble/pebble.slint";

export component LoginWindow inherits Window {
    title: GreeterSetup.step == 0 ? "ANGI · Sign in" : "Set up ANGI";
    background: Theme.background;
    default-font-family: "Poppins";
    default-font-size: 14px;
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    forward-focus: username;
    in property <bool> busy: false;
    in property <bool> draw-cursor: false;
    in property <string> error-text;
    callback sign-in(string, string);
    callback authenticated(string);
    public function show-login(account: string) {
        username.text = account;
        GreeterSetup.step = 0;
        if (account != "") { password.focus(); } else { username.focus(); }
    }
    function submit() {
        if (!root.busy) {
            root.sign-in(username.text, password.text);
            password.text = "";
        }
    }
    tracker := TouchArea {
        width: parent.width;
        height: parent.height;
        if GreeterSetup.step != 0: FirstBootPanel { width: parent.width; height: parent.height; }
        Rectangle {
            visible: GreeterSetup.step == 0;
            // Pebble Line login: a radius-xl outlined card, icon fields and one primary pill.
            width: min(440px, parent.width - 48px);
            height: 452px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-radius: Theme.radius-xl;
            border-width: Theme.stroke-hair;
            border-color: Theme.line;
            VerticalLayout {
                padding: Theme.space-10;
                spacing: Theme.space-3;
                Image {
                    height: 44px;
                    source: @image-url("../../../brand/brand-mark-text.svg");
                    image-fit: contain;
                    colorize: Theme.ink;
                    accessible-label: "ANGI";
                }
                Rectangle { height: Theme.space-2; }
                Heading2 { text: "Sign in"; horizontal-alignment: center; }
                Hint { text: "Welcome back to your desktop."; horizontal-alignment: center; }
                Rectangle { height: Theme.space-2; }
                username := TextField {
                    height: 46px;
                    icon: Icons.user;
                    placeholder-text: "Username";
                    enabled: !root.busy;
                    accepted => { password.focus(); }
                }
                password := TextField {
                    height: 46px;
                    icon: Icons.lock;
                    placeholder-text: "Password";
                    input-type: InputType.password;
                    enabled: !root.busy;
                    accepted => { root.submit(); }
                }
                Button {
                    variant: ButtonVariant.primary;
                    size: ControlSize.md;
                    horizontal-stretch: 1;
                    text: root.busy ? "Signing in…" : "Sign in";
                    enabled: !root.busy;
                    clicked => { root.submit(); }
                }
                Text { text: root.error-text; color: Theme.danger; wrap: word-wrap; font-size: Theme.text-body-sm; horizontal-alignment: center; min-height: 32px; }
            }
        }
    }
    if root.draw-cursor: Cursor { x: tracker.mouse-x; y: tracker.mouse-y; shape: 0; }
}
