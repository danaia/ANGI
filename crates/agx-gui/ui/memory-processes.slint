import { Theme, Sys } from "data.slint";
import { ListView } from "std-widgets.slint";
import { Button } from "pebble/pebble.slint";

export struct ProcessRow {
    pid: int,
    identity: string,
    name: string,
    memory: string,
    risk: string,
    level: int,
}

export global MemoryProcesses {
    in-out property <bool> open;
    in property <[ProcessRow]> rows;
    in property <bool> ascending;
    in property <int> count;
    in property <int> selected-pid;
    in property <bool> can-end;
    in property <bool> ending;
    in property <string> detail;
    in property <string> message;
    in-out property <string> confirmation;
    callback show();
    callback sort();
    callback pick(int, string);
    callback review();
    callback end(bool);
}

component Cell inherits Text {
    color: Theme.ink;
    font-size: Theme.text-body-sm;
    vertical-alignment: center;
    overflow: elide;
}

export component MemoryProcessDialog inherits FocusScope {
    callback dismissed();
    callback pointer-moved(length, length);
    init => { close-button.focus(); }
    function close() {
        if MemoryProcesses.confirmation != "" {
            MemoryProcesses.confirmation = "";
            close-button.focus();
        } else {
            MemoryProcesses.open = false;
            root.dismissed();
        }
    }
    key-pressed(e) => {
        if e.text == Key.Escape { root.close(); return accept; }
        reject
    }
    Rectangle {
        background: Theme.scrim;
        TouchArea {
            moved => { root.pointer-moved(self.mouse-x, self.mouse-y); }
        }
        Rectangle {
            width: min(850px, parent.width - 32px);
            height: min(680px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-color: Theme.line-strong;
            border-width: 1px;
            border-radius: Theme.radius-xl;
            background: Theme.surface;
            clip: true;
            VerticalLayout {
                padding: Theme.space-6;
                spacing: 10px;
                HorizontalLayout {
                    alignment: stretch;
                    spacing: 12px;
                    Text { text: "Memory processes"; color: Theme.ink; font-size: Theme.text-heading-2; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                    close-button := Button { text: "Close"; clicked => { root.close(); } }
                }
                Text {
                    text: Sys.mem-detail + " used · " + MemoryProcesses.count + " processes";
                    color: Theme.ink-muted;
                    font-size: Theme.text-body-sm;
                }
                Rectangle {
                    height: 34px;
                    background: Theme.surface-muted;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 12px; spacing: 8px;
                        Cell { text: "PID"; width: 56px; }
                        Cell { text: "Process"; horizontal-stretch: 1; }
                        Button {
                            text: MemoryProcesses.ascending ? "Memory ↑" : "Memory ↓";
                            width: 112px;
                            accessible-label: MemoryProcesses.ascending ? "Memory usage, smallest first" : "Memory usage, largest first";
                            clicked => { MemoryProcesses.sort(); }
                        }
                        Cell { text: "Risk"; width: 94px; }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for row[i] in MemoryProcesses.rows: Rectangle {
                        height: 29px;
                        background: MemoryProcesses.selected-pid == row.pid ? Theme.surface-muted : mod(i, 2) == 0 ? Theme.background : Theme.surface;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 12px; spacing: 8px;
                            Cell { text: "\{row.pid}"; width: 56px; color: Theme.ink-muted; }
                            Cell { text: row.name; horizontal-stretch: 1; }
                            Cell { text: row.memory; width: 112px; }
                            Cell {
                                text: row.risk; width: 94px;
                                color: row.level == 0 ? Theme.success : row.level == 1 ? Theme.warning : Theme.ink-muted;
                            }
                        }
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            moved => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                            clicked => { MemoryProcesses.pick(row.pid, row.identity); }
                        }
                    }
                }
                Text {
                    height: 36px;
                    text: MemoryProcesses.detail;
                    color: Theme.ink-muted;
                    font-size: Theme.text-body-sm;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Cell { horizontal-stretch: 1; text: MemoryProcesses.message; color: Theme.ink-muted; }
                    Button {
                        text: "End process…";
                        enabled: MemoryProcesses.can-end && !MemoryProcesses.ending;
                        clicked => { MemoryProcesses.review(); }
                    }
                }
            }
            if MemoryProcesses.confirmation != "": Rectangle {
                background: Theme.scrim;
                TouchArea { }
                Rectangle {
                    width: min(520px, parent.width - 20px);
                    height: confirmation-layout.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.line-strong;
                    border-radius: Theme.radius-lg;
                    confirmation-layout := VerticalLayout {
                        padding: Theme.space-6;
                        spacing: 12px;
                        Text { text: MemoryProcesses.confirmation; color: Theme.ink; wrap: word-wrap; }
                        Text {
                            text: "End asks the process to stop. Force stop ends it immediately without cleanup.";
                            color: Theme.ink-muted; font-size: Theme.text-body-sm; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            cancel := Button { text: "Cancel"; clicked => { root.close(); } }
                            Button { text: "End"; clicked => { MemoryProcesses.end(false); close-button.focus(); } }
                            Button { text: "Force stop"; clicked => { MemoryProcesses.end(true); close-button.focus(); } }
                        }
                        init => { cancel.focus(); }
                    }
                }
            }
        }
    }
}
