import { Caption, Divider, Floating, Icons, MenuItem, Theme } from "pebble/pebble.slint";

export component PanelMenu inherits Rectangle {
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <int> workspace;
    in property <int> workspace-count;
    callback send-to(int);
    callback close-panel();
    callback dismissed();
    callback pointer-moved(length, length);

    private property <int> selected: 0;
    private property <length> row-height: Theme.space-10;

    function destination(index: int) -> int {
        index < root.workspace ? index : index + 1
    }
    function activate(index: int) {
        if index == root.workspace-count - 1 { root.close-panel(); }
        else { root.send-to(root.destination(index)); }
    }

    init => { keys.focus(); }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.dismissed(); }
            else if e.text == Key.DownArrow || e.text == Key.Tab {
                root.selected = mod(root.selected + (e.modifiers.shift ? -1 : 1) + root.workspace-count, root.workspace-count);
            } else if e.text == Key.UpArrow || e.text == Key.Backtab {
                root.selected = mod(root.selected + root.workspace-count - 1, root.workspace-count);
            } else if e.text == Key.Return || e.text == " " { root.activate(root.selected); }
            accept
        }
        key-released(e) => { accept }
    }
    TouchArea {
        pointer-event(e) => { root.pointer-moved(self.mouse-x, self.mouse-y); }
        clicked => { root.dismissed(); }
        scroll-event(e) => { accept }
    }
    Floating {
        x: clamp(root.anchor-x, Theme.space-2, max(Theme.space-2, root.width - self.width - Theme.space-2));
        y: clamp(root.anchor-y, Theme.space-2, max(Theme.space-2, root.height - self.height - Theme.space-2));
        width: 212px;
        height: root.workspace-count * root.row-height + Theme.space-6 + 4 * Theme.space-2 + Theme.stroke-hair;

        VerticalLayout {
            padding: Theme.space-2;
            spacing: 0;
            HorizontalLayout {
                height: Theme.space-6;
                padding-left: Theme.space-3;
                Caption { text: "Send to workspace"; vertical-alignment: center; }
            }
            for i in root.workspace-count - 1: MenuItem {
                height: root.row-height;
                text: "Workspace " + (root.destination(i) + 1);
                highlighted: root.selected == i;
                clicked => { root.activate(i); }
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
            }
            VerticalLayout {
                padding: Theme.space-2;
                Divider { }
            }
            MenuItem {
                height: root.row-height;
                text: "Close window";
                icon: Icons.x;
                danger: true;
                highlighted: root.selected == root.workspace-count - 1;
                clicked => { root.activate(root.workspace-count - 1); }
                pointer-moved(x, y) => { root.pointer-moved(x, y); }
            }
        }
    }
}
