// Pebble Line icons: 24px grid, 1.75px outline, round caps. Draw them with `Icon` (colorized).
// Generated from the Pebble Line bundle plus ANGI additions; add new ones in the same grammar.
export global Icons {
    out property <image> app-window: @image-url("../icons/pebble/app-window.svg");
