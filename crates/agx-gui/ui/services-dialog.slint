import { Theme } from "data.slint";
import { Services } from "services.slint";
import { UpdateButton } from "service-controls.slint";
import { ScrollView } from "std-widgets.slint";

export component ServiceUpdateDialog inherits FocusScope {
    callback dismissed();
    callback pointer-moved(length, length);
    private property <bool> can-install: Services.pending.action != "" && !Services.pending.restart-pending && !Services.busy;
    init => { close-button.focus-button(); }
    function close() { Services.review-open = false; root.dismissed(); }
    key-pressed(e) => {
        if e.text == Key.Escape { root.close(); return accept; }
        if e.text == Key.Tab || e.text == Key.Backtab {
            if close-button.focused && root.can-install { install-button.focus-button(); }
            else { close-button.focus-button(); }
            return accept;
        }
        // Keep desktop shortcuts from reaching the windows behind this review.
        if e.modifiers.meta || e.modifiers.alt || e.modifiers.control { return accept; }
        reject
    }
    key-released(e) => { accept }
    Rectangle {
        background: Theme.scrim;
        TouchArea {
            moved => { root.pointer-moved(self.mouse-x, self.mouse-y); }
            scroll-event(e) => { accept }
        }
        Rectangle {
            width: min(600px, parent.width - 32px);
            height: min(470px, parent.height - 32px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface; border-radius: Theme.radius-xl; border-width: 1px;
            border-color: Theme.line-strong;
            clip: true;
            VerticalLayout {
                padding: Theme.space-8; spacing: Theme.space-4;
                Text {
                    text: Services.pending.restart-pending ? "Restart required to finish" : Services.pending.action == "" ? "Upstream version details" : Services.pending.key == "desktop" ? "Install desktop update" : "Install update";
                    color: Theme.ink; font-size: Theme.text-heading-2; font-weight: 500;
                }
                Text {
                    text: Services.pending.name + (Services.pending.latest != "" && Services.pending.key != "desktop" ? " · " + Services.pending.installed + " → " + Services.pending.latest : "");
                    color: Theme.ink; font-size: Theme.text-body-sm; wrap: word-wrap;
                }
                ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 16px;
                        if Services.pending.action == "" && !Services.pending.restart-pending: Text {
                            text: "This check found a newer version published upstream.";
                            color: Theme.warning; font-size: Theme.text-body; font-weight: 500; wrap: word-wrap;
                        }
                        Rectangle {
                            min-height: 116px;
                            background: Theme.surface-muted; border-radius: Theme.radius-md;
                            VerticalLayout {
                                padding: 14px; spacing: 10px;
                                Text {
                                    text: Services.pending.restart-kind == "computer" ? "Computer reboot required after installation"
                                        : Services.pending.restart-kind == "desktop" ? "Desktop restart required"
                                        : Services.pending.restart-label;
                                    color: Services.pending.restart-kind == "computer" || Services.pending.restart-pending ? Theme.warning : Theme.accent;
                                    font-size: Theme.text-body; font-weight: 500; wrap: word-wrap;
                                }
                                Text { text: Services.pending.action == "" && Services.pending.restart-kind == "computer" ? "A compatible ANGI system image would take effect after reboot." : Services.pending.restart-detail; color: Theme.ink; font-size: Theme.text-body-sm; wrap: word-wrap; }
                            }
                        }
                        if Services.pending.action != "" && !Services.pending.restart-pending: Text {
                            text: Services.pending.install-note; color: Theme.ink; font-size: Theme.text-small; wrap: word-wrap;
                        }
                        if Services.pending.restart-pending || Services.pending.action != "": Text {
                            text: Services.pending.restart-pending ? "The update is installed. You can keep working and restart the desktop when ready."
                                : "No restart will happen automatically.";
                            color: Theme.ink-muted; font-size: Theme.text-small; wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end; spacing: root.can-install ? 10px : 0px;
                    close-button := UpdateButton {
                        width: 100px; show-icon: false;
                        label: root.can-install ? "Cancel" : Services.pending.restart-pending ? "Later" : "Close";
                        clicked => { root.close(); }
                    }
                    install-button := UpdateButton {
                        width: root.can-install ? 180px : 0px;
                        visible: root.can-install; enabled: root.can-install; primary: true;
                        label: "Install update"; icon: @image-url("icons/update.svg");
                        clicked => {
                            if root.can-install {
                                let key = Services.pending.key;
                                root.close(); Services.update(key);
                            }
                        }
                    }
                }
            }
        }
    }
}
