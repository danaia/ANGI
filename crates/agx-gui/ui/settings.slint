// Native Settings content hosted inside an ordinary desktop tile.
import { Theme, Icons, Heading2, Hint, Label, Caption, Kbd, Button, ButtonVariant, Select, Slider, SegmentedControl, NavItem, Divider, VDivider } from "pebble/pebble.slint";
import { ScrollView } from "std-widgets.slint";
import { HoverDwell, HoverTip } from "hover-tip.slint";
import { BluetoothPage, BluetoothSettings, BtDevice, BtApproval } from "bluetooth.slint";
import { AppearancePage, AppearanceSettings } from "settings-appearance.slint";
import { NightLight } from "night-light.slint";
import { KeyBindingsPage } from "settings-key-bindings.slint";
import { SoundPage, SoundSettings } from "settings-sound.slint";
import { AiPage } from "settings-ai.slint";
import { SecurityPage, SecuritySettings } from "security.slint";
import { DriverRow, DriversPage, DriversSettings } from "settings-drivers.slint";

export { BluetoothSettings, BtDevice, BtApproval, AppearanceSettings, SoundSettings, SecuritySettings, DriverRow, DriversSettings }

export global MouseSettings {
    in-out property <float> speed: 0;
    in-out property <bool> adaptive: true;
    in-out property <bool> left-handed: false;
    in-out property <bool> natural: false;
    in-out property <float> scroll-speed: 100;
    in-out property <string> status: "Changes apply immediately and are saved for your account";
    in-out property <bool> native: false;
    in-out property <int> focus-serial: 0;
    // Chosen Settings page: 0 Mouse & pointer, 1 Bluetooth, 2 Appearance, 3 Sound, 4 Key bindings, 5 AI, 6 Security, 7 Drivers. Kept here because the desktop
    // rebuilds the panel whenever its window moves in the list (maximize, another app opening), which
    // would otherwise send the person back to the first page.
    in-out property <int> page: 0;
    callback activate();
    callback refresh();
    callback changed();
    callback reset();
}

// One preference: name and description on the left, its control on the right (below when compact),
// separated from the previous row by a 1px rule.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <bool> compact;
    min-height: root.compact ? info.preferred-height + 2 * Theme.space-5 + Theme.space-3 + 42px
        : max(88px, info.preferred-height + 2 * Theme.space-5);
    Divider { y: 0; }
    info := VerticalLayout {
        x: 0; y: root.compact ? Theme.space-5 : (parent.height - self.height) / 2;
        width: root.compact ? parent.width : max(1px, parent.width - 312px);
        height: self.preferred-height;
        spacing: 2px;
        Label { text: root.label; }
        Hint { text: root.description; }
    }
    Rectangle {
        x: root.compact ? 0px : parent.width - self.width;
        y: root.compact ? info.y + info.height + Theme.space-3 : (parent.height - self.height) / 2;
        width: root.compact ? parent.width : 280px;
        height: 42px;
        @children
    }
}

export component SettingsPanel inherits Rectangle {
    in property <bool> active;
    property <int> request: MouseSettings.focus-serial;
    changed request => { if (root.active) { root.focus-current(); } }
    changed active => { if (root.active) { root.focus-current(); } else { root.focus-step = -1; } }
    callback pointer-moved(length, length);
    background: Theme.surface;
    clip: true;
    property <int> focus-step: -1;
    property <bool> narrow: root.width < 620px;
    property <bool> drivers-nav-hovered: false;
    property <length> drivers-nav-bottom: 0px;
    // PageUp and PageDown switch pages from the keyboard.
    property <int> page <=> MouseSettings.page;
    property <bool> bluetooth-showing: root.active && root.page == 1;
    changed bluetooth-showing => { BluetoothSettings.active = root.bluetooth-showing; }
    property <bool> sound-showing: root.active && root.page == 3;
    changed sound-showing => { SoundSettings.active = root.sound-showing; }
    property <bool> security-showing: root.active && root.page == 6;
    changed security-showing => { SecuritySettings.active = root.security-showing; }
    property <bool> drivers-showing: root.active && root.page == 7;
    changed drivers-showing => { if (self.drivers-showing) { DriversSettings.open(); } }
    function show-page(index: int) {
        if (index == root.page || index < 0 || index > 7) { return; }
        root.page = index;
        root.focus-step = -1;
        if index == 4 { binding-page.focus-first(); } else { keys.focus(); }
    }
    function next-bluetooth-control(backwards: bool) {
        root.focus-step = root.focus-step < 0 ? (backwards ? 3 : 0) : mod(root.focus-step + (backwards ? 3 : 1), 4);
        if (root.focus-step == 0) { bluetooth-page.focus-power(); }
        if (root.focus-step == 1) { bluetooth-page.focus-search(); }
        if (root.focus-step == 2) { keys.focus(); bluetooth-page.enter-list(); }
        if (root.focus-step == 3) { keys.focus(); }
    }
    function next-appearance-control(backwards: bool) {
        // Theme, Night light, Warmth (only while night light is on), Refresh.
        root.focus-step = root.focus-step < 0 ? (backwards ? 3 : 0) : mod(root.focus-step + (backwards ? 3 : 1), 4);
        if (root.focus-step == 2 && !NightLight.enabled) { root.focus-step = backwards ? 1 : 3; }
        if (root.focus-step == 0) { appearance-page.focus-theme(); }
        if (root.focus-step == 1) { appearance-page.focus-night-light(); }
        if (root.focus-step == 2) { appearance-page.focus-warmth(); }
        if (root.focus-step == 3) { keys.focus(); }
    }
    function next-control(backwards: bool) {
        if root.page == 7 { if (!DriversSettings.busy) { drivers-page.focus-check(); } return; }
        if root.page == 4 { binding-page.focus-first(); return; }
        if (root.page == 1) { root.next-bluetooth-control(backwards); return; }
        if (root.page == 2) { root.next-appearance-control(backwards); return; }
        if (root.page == 3) {
            root.focus-step = sound-page.next-focus(root.focus-step, backwards);
            if (root.focus-step == 6) { keys.focus(); }
            return;
        }
        root.focus-step = root.focus-step < 0 ? (backwards ? 6 : 0) : mod(root.focus-step + (backwards ? 6 : 1), 7);
        if (root.focus-step == 0) { root.reveal(speed-row.absolute-position.y, speed-row.height); speed-slider.focus(); }
        if (root.focus-step == 1) { root.reveal(acceleration-row.absolute-position.y, acceleration-row.height); acceleration-choice.focus(); }
        if (root.focus-step == 2) { root.reveal(primary-row.absolute-position.y, primary-row.height); primary-choice.focus(); }
        if (root.focus-step == 3) { root.reveal(direction-row.absolute-position.y, direction-row.height); direction-choice.focus(); }
        if (root.focus-step == 4) { root.reveal(scroll-row.absolute-position.y, scroll-row.height); scroll-slider.focus(); }
        if (root.focus-step == 5) { reset-button.focus(); }
        if (root.focus-step == 6) { keys.focus(); }
    }

    function reveal(y: length, h: length) {
        let top = y - settings-scroll.absolute-position.y;
        if (top < 12px) { settings-scroll.content-y = min(0px, settings-scroll.content-y - top + 12px); }
        else if (top + h > settings-scroll.height - 12px) {
            settings-scroll.content-y = max(min(0px, settings-scroll.height - settings-scroll.content-height), settings-scroll.content-y - top - h + settings-scroll.height - 12px);
        }
    }
    function moved(x: length, y: length) { root.pointer-moved(x, y); }
    function changed-by-user() { MouseSettings.activate(); MouseSettings.changed(); }
    forward-focus: keys;
    public function focus-current() {
        if root.page == 4 { binding-page.focus-first(); } else { keys.focus(); }
    }
    init => {
        BluetoothSettings.active = root.bluetooth-showing;
        SoundSettings.active = root.sound-showing;
        SecuritySettings.active = root.security-showing;
        if (root.drivers-showing) { DriversSettings.open(); }
        if (root.active) { root.focus-current(); }
    }
    tracker := TouchArea {
        changed mouse-x => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        changed mouse-y => { root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { MouseSettings.activate(); keys.focus(); } }
    keys := FocusScope {
        // Tabbing into the panel lands on its first control rather than the panel itself.
        focus-gained(reason) => { if (reason == FocusReason.tab-navigation && root.focus-step < 0) { root.next-control(false); } }
        key-pressed(e) => {
            if (e.modifiers.meta || e.modifiers.alt || e.modifiers.control) { return reject; }
            if root.page != 4 && root.page != 6 && (e.text == Key.Tab || e.text == Key.Backtab) {
                root.next-control(e.modifiers.shift || e.text == Key.Backtab);
                return accept;
            }
            if (e.text == Key.PageDown) { root.show-page(root.page + 1); return accept; }
            if (e.text == Key.PageUp) { root.show-page(root.page - 1); return accept; }
            if root.page == 4 || root.page == 6 || root.page == 7 { return reject; }
            if (root.page == 1 && bluetooth-page.key(e.text)) { return accept; }
            if (e.text == Key.Escape) { keys.focus(); }
            accept
        }
        key-released(e) => { reject }
        VerticalLayout {
            spacing: 0;
            HorizontalLayout {
                spacing: 0;
                // Keep every category reachable in short Settings tiles.
                nav := ScrollView {
                    width: root.narrow ? 64px : 220px;
                    content-width: self.width;
                    VerticalLayout {
                        min-height: nav.height;
                        padding-left: Theme.space-3; padding-right: Theme.space-3;
                        padding-top: Theme.space-5; padding-bottom: Theme.space-5;
                        spacing: Theme.space-1;
                        if !root.narrow: HorizontalLayout {
                            height: 24px;
                            padding-left: Theme.space-4;
                            Caption { text: "PREFERENCES"; }
                        }
                        for item[index] in [
                            { label: "Mouse & pointer", icon: Icons.sliders },
                            { label: "Bluetooth", icon: Icons.bluetooth },
                            { label: "Appearance", icon: Theme.dark ? Icons.moon : Icons.sun },
                            { label: "Sound", icon: Icons.speaker },
                            { label: "Key bindings", icon: Icons.keyboard },
                            { label: "AI", icon: Icons.sparkle },
                            { label: "Security", icon: Icons.lock },
                            { label: "Drivers", icon: Icons.monitor },
                        ]: NavItem {
                            text: item.label; icon: item.icon;
                            current: root.page == index;
                            compact: root.narrow;
                            clicked => {
                                if (index == 7) { drivers-tip.dismiss(); }
                                // Raising Settings can rebuild this panel. Save the page first.
                                root.show-page(index);
                                MouseSettings.activate();
                            }
                            changed has-hover => {
                                if (index == 7) { root.drivers-nav-hovered = self.has-hover; }
                            }
                            pointer-moved(x, y) => {
                                if (index == 7) {
                                    root.drivers-nav-bottom = self.absolute-position.y - root.absolute-position.y + self.height;
                                }
                                root.moved(x, y);
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                        if !root.narrow: HorizontalLayout {
                            padding-left: Theme.space-4;
                            spacing: Theme.space-1;
                            alignment: start;
                            Kbd { text: "PgUp"; }
                            Kbd { text: "PgDn"; }
                            Text { text: " switch page"; color: Theme.ink-muted; font-size: Theme.text-small; vertical-alignment: center; }
                        }
                    }
                }
                VDivider { }
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    // All pages stay instantiated, so the Mouse page's controls keep their identity.
                    settings-scroll := ScrollView {
                        width: parent.width; height: parent.height;
                        visible: root.page == 0;
                        content-width: self.width;
                        VerticalLayout {
                            padding-left: root.narrow ? Theme.space-4 : Theme.space-8;
                            padding-right: self.padding-left;
                            padding-top: root.narrow ? Theme.space-4 : 28px;
                            padding-bottom: Theme.space-6;
                            spacing: 0;
                            Heading2 { text: "Mouse & pointer"; }
                            Hint { text: "Fine-tune how your mouse moves, clicks and scrolls."; }
                            if !MouseSettings.native: Text { text: "Preview · native mouse controls apply on the ANGI device."; color: Theme.warning; font-size: Theme.text-small; wrap: word-wrap; }
                            Rectangle { height: Theme.space-3; }
                            speed-row := SettingRow {
                                compact: root.width < 760px;
                                label: "Pointer speed";
                                description: "Find a comfortable pace. Try +30 for a faster pointer.";
                                VerticalLayout {
                                    spacing: 0;
                                    speed-slider := Slider {
                                        minimum: -100; maximum: 100; step: 5;
                                        value <=> MouseSettings.speed;
                                        accessible-label: "Pointer speed";
                                        changed => { root.changed-by-user(); }
                                        pointer-moved(x, y) => { root.moved(x, y); }
                                    }
                                    HorizontalLayout {
                                        Text { text: "Slower"; color: Theme.ink-muted; font-size: Theme.text-small; }
                                        Text { text: (MouseSettings.speed > 0 ? "+" : "") + round(MouseSettings.speed); color: Theme.ink; font-size: Theme.text-small; font-weight: 500; horizontal-alignment: center; }
                                        Text { text: "Faster"; color: Theme.ink-muted; font-size: Theme.text-small; horizontal-alignment: right; }
                                    }
                                }
                            }
                            acceleration-row := SettingRow {
                                compact: root.width < 760px;
                                label: "Pointer acceleration";
                                description: "Move farther with a quick sweep. Turn off for consistent movement.";
                                acceleration-choice := Select {
                                    accessible-label: "Pointer acceleration";
                                    model: ["Adaptive", "Off (constant)"];
                                    current-index: MouseSettings.adaptive ? 0 : 1;
                                    selected(value) => { MouseSettings.adaptive = self.current-index == 0; root.changed-by-user(); }
                                    pointer-moved(x, y) => { root.moved(x, y); }
                                }
                            }
                            primary-row := SettingRow {
                                compact: root.width < 760px;
                                label: "Primary button";
                                description: "Choose the button you use to select and drag.";
                                HorizontalLayout {
                                    alignment: end;
                                    primary-choice := SegmentedControl {
                                        label: "Primary button";
                                        options: ["Left", "Right"];
                                        current-index: MouseSettings.left-handed ? 1 : 0;
                                        selected(index) => { MouseSettings.left-handed = index == 1; root.changed-by-user(); }
                                        pointer-moved(x, y) => { root.moved(x, y); }
                                    }
                                }
                            }
                            direction-row := SettingRow {
                                compact: root.width < 760px;
                                label: "Scroll direction";
                                description: "Natural scrolling moves content in the direction of your gesture.";
                                HorizontalLayout {
                                    alignment: end;
                                    direction-choice := SegmentedControl {
                                        label: "Scroll direction";
                                        options: ["Standard", "Natural"];
                                        current-index: MouseSettings.natural ? 1 : 0;
                                        selected(index) => { MouseSettings.natural = index == 1; root.changed-by-user(); }
                                        pointer-moved(x, y) => { root.moved(x, y); }
                                    }
                                }
                            }
                            scroll-row := SettingRow {
                                compact: root.width < 760px;
                                label: "Scroll speed";
                                description: "How far one wheel step or scroll gesture travels.";
                                VerticalLayout {
                                    spacing: 0;
                                    scroll-slider := Slider {
                                        minimum: 25; maximum: 300; step: 25;
                                        value <=> MouseSettings.scroll-speed;
                                        accessible-label: "Scroll speed";
                                        changed => { root.changed-by-user(); }
                                        pointer-moved(x, y) => { root.moved(x, y); }
                                    }
                                    Text { text: round(MouseSettings.scroll-speed) + "%"; color: Theme.ink; font-size: Theme.text-small; font-weight: 500; horizontal-alignment: center; }
                                }
                            }
                            Rectangle { height: Theme.space-2; }
                            // Dashed in the design; Slint has no dashed stroke, so a line-strong outline stands in.
                            test-pad := Rectangle {
                                height: 112px;
                                border-radius: Theme.radius-md;
                                background: test.has-hover ? Theme.surface-hover : transparent;
                                border-width: Theme.stroke-hair; border-color: Theme.line-strong;
                                property <int> clicks: 0;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.space-1;
                                    padding: Theme.space-3;
                                    Label { text: "Try it here"; horizontal-alignment: center; }
                                    Hint { text: test-pad.clicks == 0 ? "Move the pointer and click to test your settings" : test-pad.clicks == 1 ? "1 click registered" : test-pad.clicks + " clicks registered"; horizontal-alignment: center; }
                                }
                                test := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { parent.clicks += 1; }
                                    moved => { root.moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                                }
                            }
                        }
                    }
                    binding-page := KeyBindingsPage {
                        width: parent.width; height: parent.height;
                        visible: root.page == 4;
                        pointer-moved(x, y) => { root.moved(x, y); }
                    }
                    bluetooth-page := BluetoothPage {
                        width: parent.width; height: parent.height;
                        visible: root.page == 1;
                        compact: root.narrow;
                        pointer-moved(x, y) => { root.moved(x, y); }
                    }
                    ai-page := AiPage {
                        width: parent.width; height: parent.height;
                        visible: root.page == 5;
                        compact: root.narrow;
                        pointer-moved(x, y) => { root.moved(x, y); }
                    }
                    security-page := SecurityPage {
                        width: parent.width; height: parent.height;
                        visible: root.page == 6;
                        compact: root.narrow;
                        pointer-moved(x, y) => { root.moved(x, y); }
                    }
                    drivers-page := DriversPage {
                        width: parent.width; height: parent.height;
                        visible: root.page == 7;
                        compact: root.narrow;
                        pointer-moved(x, y) => { root.moved(x, y); }
                    }
                    sound-page := SoundPage {
                        width: parent.width; height: parent.height;
                        visible: root.page == 3;
                        compact: root.narrow;
                        pointer-moved(x, y) => { root.moved(x, y); }
                    }
                    appearance-page := AppearancePage {
                        width: parent.width; height: parent.height;
                        visible: root.page == 2;
                        compact: root.narrow;
                        activate => { MouseSettings.activate(); }
                        pointer-moved(x, y) => { root.moved(x, y); }
                    }
                }
            }
            Divider { visible: root.page != 4 && root.page != 7; }
            // Footer: status on the left, page actions on the right (stacked when narrow).
            Rectangle {
                visible: root.page != 4 && root.page != 7;
                height: !self.visible ? 0px : root.width < 500px ? 152px : 60px;
                Text {
                    visible: root.width < 500px || root.width >= 640px;
                    x: Theme.space-6; y: root.width < 500px ? Theme.space-3 : 0px;
                    width: root.width < 500px ? parent.width - 2 * Theme.space-6 : max(0px, parent.width - 380px);
                    height: root.width < 500px ? 36px : parent.height;
                    vertical-alignment: center;
                    text: root.page == 1 ? (BluetoothSettings.error != "" ? BluetoothSettings.error : BluetoothSettings.status)
                        : root.page == 2 ? AppearanceSettings.status : (root.page == 3 || root.page == 5 || root.page == 6) ? "" : MouseSettings.status;
                    color: root.page == 1 && BluetoothSettings.error != "" ? Theme.danger : Theme.ink-muted;
                    font-size: Theme.text-body-sm;
                    wrap: word-wrap; overflow: elide;
                }
                reset-button := Button {
                    visible: root.page == 0;
                    variant: ButtonVariant.ghost;
                    width: self.preferred-width;
                    x: root.width < 500px ? Theme.space-4 : parent.width - self.width - Theme.space-4;
                    y: parent.height - self.height - Theme.space-3;
                    text: "Restore defaults";
                    clicked => { MouseSettings.activate(); MouseSettings.reset(); }
                    pointer-moved(x, y) => { root.moved(x, y); }
                }
            }
        }
    }
    }
    drivers-tip := HoverDwell { hovered: root.narrow && root.drivers-nav-hovered; }
    HoverTip {
        shown: drivers-tip.ready;
        text: "Drivers";
        width: 104px;
        x: Theme.space-3;
        y: clamp(root.drivers-nav-bottom + Theme.space-2, 0px, max(0px, root.height - self.height - Theme.space-2));
    }
}
