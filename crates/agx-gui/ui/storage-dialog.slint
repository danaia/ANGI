import { Theme } from "data.slint";
import { StorageView } from "storage.slint";
import { ScrollView } from "std-widgets.slint";
import { Button } from "pebble/pebble.slint";

export component StorageDialog inherits FocusScope {
    private property <color> risk-color: StorageView.risk-level == 0 ? Theme.success-ink
        : StorageView.risk-level == 1 ? Theme.warning-ink : Theme.danger-ink;
    callback dismissed;
    callback pointer-moved(length, length);
    init => { close-button.focus(); }
    function close() {
        if !StorageView.busy {
            StorageView.selected-open = false;
            StorageView.confirming = false;
            root.dismissed();
        }
    }
    key-pressed(e) => {
        if e.text == Key.Tab || e.text == Key.Backtab {
            if close-button.has-focus && delete-button.enabled { delete-button.focus(); }
            else { close-button.focus(); }
            return accept;
        }
        if e.text == Key.Escape {
            if StorageView.confirming && !StorageView.busy { StorageView.confirming = false; }
            else { root.close(); }
            return accept;
        }
        reject
    }
    Rectangle {
        background: Theme.scrim;
        TouchArea {
            moved => { root.pointer-moved(self.mouse-x, self.mouse-y); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(580px, parent.width - 32px);
            height: min(440px, parent.height - 32px);
            background: Theme.surface;
            border-color: Theme.line-strong;
            border-width: 1px; border-radius: Theme.radius-xl;
            VerticalLayout {
                padding: Theme.space-8; spacing: Theme.space-3;
                Text {
                    text: StorageView.confirming
                        ? "Permanently delete this item?"
                        : (StorageView.selected-trashed ? "Trash item" : "File details");
                    color: Theme.ink; font-size: Theme.text-heading-2; font-weight: 500;
                }
                ScrollView {
                    content-width: self.width;
                    VerticalLayout {
                        spacing: 12px;
                        Text { text: StorageView.selected-path; wrap: char-wrap; color: Theme.ink; font-size: Theme.text-small; }
                        Text { text: StorageView.selected-detail; wrap: word-wrap; color: Theme.ink; font-size: Theme.text-small; }
                        if !StorageView.selected-trashed: VerticalLayout {
                            spacing: 7px;
                            HorizontalLayout {
                                Text { text: "Estimated removal risk"; color: Theme.ink; font-size: Theme.text-small; }
                                Text { text: StorageView.risk-label; color: root.risk-color; font-size: Theme.text-small; font-weight: 500; horizontal-alignment: right; }
                            }
                            Rectangle {
                                height: 10px;
                                accessible-role: image;
                                accessible-label: "Estimated removal risk: " + StorageView.risk-label;
                                HorizontalLayout {
                                    spacing: 3px;
                                    for i in [0, 1, 2]: Rectangle {
                                        background: StorageView.risk-level >= i ? root.risk-color : Theme.surface-muted;
                                        border-radius: 2px;
                                    }
                                }
                            }
                            HorizontalLayout {
                                Text { text: "Low"; color: Theme.ink-muted; font-size: Theme.text-caption; }
                                Text { text: "Medium"; color: Theme.ink-muted; font-size: Theme.text-caption; horizontal-alignment: center; }
                                Text { text: "High"; color: Theme.ink-muted; font-size: Theme.text-caption; horizontal-alignment: right; }
                            }
                            Text { text: StorageView.risk-reason; wrap: word-wrap; color: Theme.ink; font-size: Theme.text-small; }
                            Text { text: "Estimated from location and file type; backups are not verified."; wrap: word-wrap; color: Theme.ink-muted; font-size: Theme.text-caption; }
                        }
                        Text {
                            text: StorageView.busy ? "Working…"
                                : StorageView.message != "" ? StorageView.message
                                : StorageView.selected-trashed
                                    ? (StorageView.confirming ? "This permanently removes the item and frees its space. This cannot be undone." : "Restore the item to its original location or delete it permanently.")
                                    : "You can restore this file from Trash. It still uses disk space until permanently deleted.";
                            wrap: word-wrap;
                            color: StorageView.confirming && StorageView.selected-trashed ? Theme.danger : Theme.ink-muted;
                            font-size: Theme.text-small;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    close-button := Button {
                        text: StorageView.confirming ? "Cancel" : "Close";
                        enabled: !StorageView.busy;
                        clicked => {
                            if StorageView.confirming { StorageView.confirming = false; }
                            else { root.close(); }
                        }
                    }
                    restore-button := Button {
                        visible: StorageView.selected-trashed && !StorageView.confirming;
                        text: "Restore";
                        enabled: !StorageView.busy;
                        clicked => { StorageView.restore-file(); }
                    }
                    delete-button := Button {
                        text: StorageView.selected-trashed
                            ? (StorageView.confirming ? "Delete permanently" : "Delete permanently…")
                            : "Move to Trash";
                        enabled: !StorageView.busy && StorageView.message == "";
                        clicked => {
                            if !StorageView.selected-trashed || StorageView.confirming { StorageView.delete-file(); }
                            else { StorageView.confirming = true; close-button.focus(); }
                        }
                    }
                }
            }
        }
    }
}
